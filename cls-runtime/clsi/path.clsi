# @title path
# @description Modulo de rutas de archivos del nodo desktop.

# @description Une dos segmentos de ruta
function join(a: String, b: String) -> String {};

# @description Ultimo componente de la ruta
function basename(path: String) -> String {};

# @description Directorio padre de la ruta
function dirname(path: String) -> String {};

# @description Extension del archivo con punto (.txt; "" si no tiene)
function extname(path: String) -> String {};

# @description Ruta absoluta (relativa → unida al cwd)
function resolve(path: String) -> String {};

# @description Normaliza . y .. sin tocar el sistema de archivos
function normalize(path: String) -> String {};

# @description ¿La ruta es absoluta?
function isAbsolute(path: String) -> bool {};

# @description Separador de rutas del sistema
function sep() -> String {};
