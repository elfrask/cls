var arr = [1, 2, 3, 4, 5];

function buscar(n: int) -> int {
    for each x in (arr) {
        if (x == n) { return x * 10; }
    }
    return -1;
};

function main(args: String[]) -> int {
    print("=== break en for each ===");
    for each x in (arr) {
        if (x == 3) { break; }
        print("b:", x);
    }

    print("=== continue en for each ===");
    for each x in (arr) {
        if (x == 2) { continue; }
        print("c:", x);
    }

    print("=== for each anidado en while (sin contaminar) ===");
    var i = 0;
    while (i < 3) {
        i = i + 1;
        for each x in (arr) {
            if (x == 2) { break; }
        }
        print("while i:", i);
    }

    print("=== return dentro de for each ===");
    print("buscar(4):", buscar(4));
    print("buscar(9):", buscar(9));

    print("=== while con break/continue ===");
    var j = 0;
    while (true) {
        j = j + 1;
        if (j == 2) { continue; }
        if (j > 4) { break; }
        print("j:", j);
    }

    print("=== for con break/continue ===");
    for (var k = 0; k < 6; k = k + 1) {
        if (k == 2) { continue; }
        if (k > 4) { break; }
        print("k:", k);
    }

    print("=== loop con break ===");
    var n = 0;
    loop {
        n = n + 1;
        if (n >= 3) { break; }
    }
    print("n:", n);

    return 0;
};