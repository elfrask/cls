# Repro minimo: un `const` de literal ENTERO infiere TIPO LITERAL y no se puede
# usar en aritmetica contra un `Int` (el chequeo de operadores exige Int/Float).
#
# Esperado: 12
# Obtenido: error de compilacion
#   [ERROR] Operador requiere tipos numericos, encontro Int y 5 (en `x + N`)
#
#   target\debug\clx.exe run examples\conformance\findings\05-const-int-literal-arith.clsx
#
# Hallado al extraer las constantes del LCG a `const` en modules/prng (se
# dejaron como `var: int`). `const` de String si funciona como String.

const N = 5;

function main(args: String[]) -> int {
    var x: int = 7;
    print(str(x + N));
    return 0;
}
