(define (map f xs) (if (null? xs) '() (cons (f (car xs)) (map f (cdr xs)))))
(define (range a b) (if (>= a b) '() (cons a (range (+ a 1) b))))

(display (map (lambda (x) (* x x)) (range 1 6)))
