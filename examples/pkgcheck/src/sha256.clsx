# sha256.clsx - SHA-256 (FIPS 180-4) en CLS puro (0 FFI). Prueba #8 (pkgcheck).
#
# Aritmetica de 32 bits sobre `int` (i64) con mascara 0xFFFFFFFF. CLS no tiene
# literales hex -> las constantes van en decimal. `>>` es shift aritmetico,
# pero todos los operandos se mantienen < 2^32 (no negativos) => equivale al
# shift logico.

const MASK: int = 4294967295;

const K: int[] = [
    1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993,
    2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987,
    1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774,
    264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711,
    113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291,
    1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411,
    3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218,
    1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424,
    2428436474, 2756734187, 3204031479, 3329325298
];

const H0: int[] = [
    1779033703, 3144134277, 1013904242, 2773480762,
    1359893119, 2600822924, 528734635, 1541459225
];

# Rotacion a la derecha de 32 bits.
function rotr(x: int, n: int) -> int {
    return ((x >> n) | (x << (32 - n))) & MASK;
}

# Prefijo de padding FIPS: 0x80, ceros hasta 56 mod 64, longitud (bits) BE 8B.
function pad(data: int[]) -> int[] {
    var msg: int[] = [];
    for each b in (data) { msg.push(b & 255); }
    var bitLen: int = data.length * 8;
    msg.push(128);
    while (msg.length % 64 != 56) { msg.push(0); }
    var i = 7;
    while (i >= 0) { msg.push((bitLen >> (i * 8)) & 255); i = i - 1; }
    return msg;
}

# Devuelve el digest (32 bytes) como int[8] (palabras big-endian).
export function sha256Bytes(data: int[]) -> int[] {
    var msg: int[] = pad(data);
    var h0 = H0[0];
    var h1 = H0[1];
    var h2 = H0[2];
    var h3 = H0[3];
    var h4 = H0[4];
    var h5 = H0[5];
    var h6 = H0[6];
    var h7 = H0[7];
    var off = 0;
    while (off < msg.length) {
        var w: int[] = [];
        var j = 0;
        while (j < 16) {
            var b0 = msg[off + j * 4];
            var b1 = msg[off + j * 4 + 1];
            var b2 = msg[off + j * 4 + 2];
            var b3 = msg[off + j * 4 + 3];
            w.push(((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & MASK);
            j = j + 1;
        }
        while (j < 64) {
            var x15 = w[j - 15];
            var s0 = rotr(x15, 7) ^ rotr(x15, 18) ^ (x15 >> 3);
            var x2 = w[j - 2];
            var s1 = rotr(x2, 17) ^ rotr(x2, 19) ^ (x2 >> 10);
            w.push((w[j - 16] + s0 + w[j - 7] + s1) & MASK);
            j = j + 1;
        }
        var a = h0;
        var b = h1;
        var c = h2;
        var d = h3;
        var e = h4;
        var f = h5;
        var g = h6;
        var h = h7;
        var t = 0;
        while (t < 64) {
            var S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            var ch = (e & f) ^ ((e ^ MASK) & g);
            var temp1 = (h + S1 + ch + K[t] + w[t]) & MASK;
            var S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            var maj = (a & b) ^ (a & c) ^ (b & c);
            var temp2 = (S0 + maj) & MASK;
            h = g;
            g = f;
            f = e;
            e = (d + temp1) & MASK;
            d = c;
            c = b;
            b = a;
            a = (temp1 + temp2) & MASK;
            t = t + 1;
        }
        h0 = (h0 + a) & MASK;
        h1 = (h1 + b) & MASK;
        h2 = (h2 + c) & MASK;
        h3 = (h3 + d) & MASK;
        h4 = (h4 + e) & MASK;
        h5 = (h5 + f) & MASK;
        h6 = (h6 + g) & MASK;
        h7 = (h7 + h) & MASK;
        off = off + 64;
    }
    return [h0, h1, h2, h3, h4, h5, h6, h7];
}

# --- hex ------------------------------------------------------------------

function hexNib(n: int) -> String {
    var d = n & 15;
    if (d < 10) { return char(d + 48).toString(); }
    return char(d + 87).toString();
}

# 8 digitos hex por palabra (el digest son 8 palabras -> 64 chars).
export function toHex(words: int[]) -> String {
    var out = "";
    for each wd in (words) {
        var s = 28;
        while (s >= 0) {
            out = out + hexNib((wd >> s) & 15);
            s = s - 4;
        }
    }
    return out;
}

# Digest de un string (UTF-8) en hex minuscula.
export function sha256Hex(msg: String) -> String {
    return toHex(sha256Bytes(msg.toBytes()));
}
