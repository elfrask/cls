# lexer.clsx - Tokenizador de clsh (CLS puro, sin estado).
#
# Devuelve una tupla heterogenea `(kinds, texts)`: kinds = tokens::Tok, texts = String.
#
# El tokenizador reconoce operadores sin espacios (`a>b`), comillas simples y
# dobles, escapes `\` y sustitucion de comandos `$(...)`. NO interpreta nada:
# la expansion vive en shell.clsx. Usa los metodos de `String` (`.slice`).

import "tokens" as tk;

# Salta un `$(...)`: `j` apunta justo despues de `$(`. Devuelve el indice tras `)`.
export function skip_cmdsubst(src: String, j0: int) -> int {
    var n = src.length;
    var j = j0;
    var depth = 1;
    while (j < n && depth > 0) {
        var c = src[j];
        if (c == "'") {
            j = j + 1;
            while (j < n && src[j] != "'") { j = j + 1; }
            j = j + 1;
        } elif (c == "\"") {
            j = j + 1;
            while (j < n && src[j] != "\"") {
                if (src[j] == "\\") { j = j + 2; }
                else { j = j + 1; }
            }
            j = j + 1;
        } elif (c == "\\") {
            j = j + 2;
        } elif (c == "(") {
            depth = depth + 1; j = j + 1;
        } elif (c == ")") {
            depth = depth - 1; j = j + 1;
        } else {
            j = j + 1;
        }
    }
    return j;
}

# True si el caracter es un operador no-cita. `switch` sobre String compara
# CONTENIDO (fix del finding 06), asi que despacha por el caracter natural.
function isOpByte(c: String) -> bool {
    switch (c) {
        case (";") { return true; }
        case ("&") { return true; }
        case ("|") { return true; }
        case ("(") { return true; }
        case (")") { return true; }
        case ("<") { return true; }
        case (">") { return true; }
        case default { return false; }
    }
    return false;
}

# Tupla heterogenea `(kinds, texts)`: `t[0]` tipa `tk::Tok[]` y `t[1]` `String[]`.
export function tokenize(src: String) -> (tk::Tok[], String[]) {
    var kinds: tk::Tok[] = [];
    var texts: String[] = [];
    var n = src.length;
    var i = 0;
    var DOL = "$";    while (i < n) {
        var c = src[i];

        # espacios / continuacion de linea
        if (c == " " || c == "\t" || c == "\r") { i = i + 1; continue; }
        if (c == "\\" && i + 1 < n && src[i + 1] == "\n") { i = i + 2; continue; }

        # comentario hasta fin de linea (solo en posicion de inicio de token)
        if (c == "#") {
            while (i < n && src[i] != "\n") { i = i + 1; }
            continue;
        }

        if (c == "\n") { kinds.push(tk::Tok.Sep); texts.push("\n"); i = i + 1; continue; }
        if (c == ";") { kinds.push(tk::Tok.Sep); texts.push(";"); i = i + 1; continue; }

        if (c == "&") {
            if (i + 1 < n && src[i + 1] == "&") { kinds.push(tk::Tok.And); texts.push("&&"); i = i + 2; }
            else { kinds.push(tk::Tok.Sep); texts.push("&"); i = i + 1; }
            continue;
        }
        if (c == "|") {
            if (i + 1 < n && src[i + 1] == "|") { kinds.push(tk::Tok.Or); texts.push("||"); i = i + 2; }
            else { kinds.push(tk::Tok.Pipe); texts.push("|"); i = i + 1; }
            continue;
        }
        if (c == "(") { kinds.push(tk::Tok.LP); texts.push("("); i = i + 1; continue; }
        if (c == ")") { kinds.push(tk::Tok.RP); texts.push(")"); i = i + 1; continue; }

        if (c == "<") { kinds.push(tk::Tok.Redir); texts.push("<"); i = i + 1; continue; }
        if (c == ">") {
            if (i + 1 < n && src[i + 1] == ">") { kinds.push(tk::Tok.Redir); texts.push(">>"); i = i + 2; }
            elif (i + 1 < n && src[i + 1] == "&") { kinds.push(tk::Tok.Redir); texts.push(">&"); i = i + 2; }
            else { kinds.push(tk::Tok.Redir); texts.push(">"); i = i + 1; }
            continue;
        }
        if (c == "2" && i + 1 < n && src[i + 1] == ">") {
            if (i + 2 < n && src[i + 2] == ">") { kinds.push(tk::Tok.Redir); texts.push("2>>"); i = i + 3; }
            else { kinds.push(tk::Tok.Redir); texts.push("2>"); i = i + 2; }
            continue;
        }

        # --- palabra ---
        var start = i;
        while (i < n) {
            var d = src[i];
            if (d == " " || d == "\t" || d == "\r" || d == "\n") { break; }
            if (isOpByte(d)) { break; }
            if (d == "'") {
                i = i + 1;
                while (i < n && src[i] != "'") { i = i + 1; }
                i = i + 1;
                continue;
            }
            if (d == "\"") {
                i = i + 1;
                while (i < n && src[i] != "\"") {
                    if (src[i] == "\\") { i = i + 2; continue; }
                    if (src[i] == DOL && i + 1 < n && src[i + 1] == "(") {
                        i = skip_cmdsubst(src, i + 2);
                        continue;
                    }
                    i = i + 1;
                }
                i = i + 1;
                continue;
            }
            if (d == "\\") { i = i + 2; continue; }
            if (d == DOL && i + 1 < n && src[i + 1] == "(") {
                i = skip_cmdsubst(src, i + 2);
                continue;
            }
            i = i + 1;
        }
        texts.push(src.slice(start, i));
        kinds.push(tk::Tok.Word);
    }
    return (kinds, texts);
}
