function main(args: String[]) -> int {
    var t0 = now();
    var N: int = 100000;
    var arr: int[] = [];
    var i: int = 0;
    for (i = 0; i < N; i++) {
        arr.push(i);
    }
    var sum: int = 0;
    for each x in (arr) {
        sum = sum + x;
    }
    var t1 = now();
    print("arr_len:", arr.length);
    print("arr_sum:", sum);
    print("arr_ms:", t1 - t0);
    return 0;
}
