import "math" as math;
function main(args: String[]) -> int {
    var t0 = now();
    var N: int = 200000;
    var acc: float = 0.0;
    var i: int = 0;
    for (i = 0; i < N; i++) {
        acc = acc + math.sqrt(i + 1);
        acc = acc + math.sin(i);
    }
    var t1 = now();
    print("math_result:", acc);
    print("math_ms:", t1 - t0);
    return 0;
}
