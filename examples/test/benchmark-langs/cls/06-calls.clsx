function f(x: int) -> int {
    if (x > 500000) { return x + 1; }
    return x * x;
}
function main(args: String[]) -> int {
    var t0 = now();
    var N: int = 1000000;
    var sum: int = 0;
    var i: int = 0;
    for (i = 0; i < N; i++) {
        sum = sum + f(i);
    }
    var t1 = now();
    print("call_result:", sum);
    print("call_ms:", t1 - t0);
    return 0;
}
