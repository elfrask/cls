# Unión de builtins boxeada con tag runtime: `match is` discrimina por el tag
# real del valor, no por el tipo estático de la unión.
alias M = int | String;

function main(args: String[]) -> int {
    var v: M = 5;
    var s: String = match (v) is { String -> "str", int -> "int" };
    print(s);
    v = "hola";
    print(match (v) is { String -> "str", int -> "int" });
    return 0;
};
