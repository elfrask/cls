function id<T>(x: T) -> T { return x; }

interface ObjType<T> {
    value: T
};

function whatType<T>(valor: ObjType<T>) -> String {
    return match (valor.value) is {
        String  -> "Texto",
        int     -> "Entero",
        Boolean -> "Boleano",
        default -> "Desconocido"
    };
}

function main(args: String[]) -> int {
    print(whatType<String>({ value: "abc" }));
    print(whatType<int>({ value: 123 }));
    print(whatType<Boolean>({ value: false }));

    print(id<float>(3.5));
    print(id<Boolean>(true));
    print(id<String>("hola"));

    var f = id;
    print(f<float>(4.5));

    return 0;
}
