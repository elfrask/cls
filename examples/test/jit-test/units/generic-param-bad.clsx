interface ObjType<T> {
    value: T
};

function whatType<T>(valor: ObjType<T>) -> String {
    return match (valor.value) is {
        String  -> "Texto",
        int     -> "Entero",
        Boolean -> "Boleano",
        default -> "Desconocido"
    };
}

function main(args: String[]) -> int {
    print(whatType("abc"));
    return 0;
}
