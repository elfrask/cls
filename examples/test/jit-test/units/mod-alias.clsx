# Alias de import de módulos internos: `import "math" as m` / `"strings" as s`.
# Antes el dispatch era rígido (solo funcionaba con el alias == nombre del módulo).
import "math" as m;
import "strings" as s;
import "json" as j;

function main(args: String[]) -> int {
    print("sqrt", m.sqrt(16.0));
    print("pi", m.PI);
    print("split", s.split("a,b", ","));
    print("idx", s.indexOf("hola", "l"));
    print("json", j.stringify({ a: 1 }));
    return 0;
};
