# Unión de primitivos con tag runtime ([tag][valor]):
# match is, print, retornos, campos, arrays y reasignaciones.
alias M = String | int | Boolean | float;

function tipo(v: M) -> String {
    return match (v) is {
        String  -> "string",
        int     -> "int",
        Boolean -> "bool",
        float   -> "float",
        default -> "?"
    };
}

function eco(v: M) -> M {
    return v;
}

class Caja {
    public var valor: M;

    function main(valor: M) {
        me.valor = valor;
    }

    function tipo() -> String {
        return tipo(me.valor);
    }
}

function main(args: String[]) -> int {
    print(tipo("abc"));
    print(tipo(123));
    print(tipo(false));
    print(tipo(3.5));

    var v: M = "inicial";
    print(v);
    v = 42;
    print(v);
    v = false;
    print(v);
    v = 3.5;
    print(v);
    print(v is Float, v is Int);

    print(tipo(eco(v)));
    var w: M = eco("eco");
    print(tipo(w), w);
    print(match (w) { "eco" -> "match-string", default -> "?" });

    print(match (v) { 3.5 -> "tres y medio", default -> "otro" });

    var caja = Caja(false);
    print(caja.tipo(), caja.valor);
    caja.valor = "hola";
    print(caja.tipo(), caja.valor);

    var xs: M[] = [];
    xs.push("a");
    xs.push(2);
    xs.push(true);
    xs.push(4.5);
    for each x in (xs) {
        print(tipo(x), x);
    }

    return 0;
}
