# BUG: un literal CMX dentro de un child de interpolacion no parsea.
# Falla tanto directo `{<p>x</p>}` como como argumento `{f((<p>x</p>))}`:
#   "Esperaba ')' , encontro <cmx>" / "Esperaba ')' , encontro '{'".
# Deberia compilar (los literales CMX son expresiones). Mientras el bug exista,
# este repro NO compila (exit != 0). Workaround documentado: precomputar el Cmx
# en una variable y referenciarla `{var}`.

function take(x: Cmx) -> Cmx { return x; }

function main(args: String[]) -> int {
    var page = (<div>{take((<p>hola</p>))}</div>);
    print("OK: CMX anidado en interpolacion compila -> " + page.tag);
    return 0;
}
