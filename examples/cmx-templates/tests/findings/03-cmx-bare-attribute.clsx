# BUG: un atributo CMX sin valor (`<input disabled />`) no llega a `props`.
# Los docs (docs/lenguaje/cmx.md) dicen que deberia valer `true`.

function main(args: String[]) -> int {
    var el = (<input disabled />);
    if (!el.props.keys().includes("disabled")) {
        print("BUG PRESENTE: atributo desnudo 'disabled' ausente de props");
        return 1;
    }
    print("OK: atributo desnudo = true");
    return 0;
}
