export function collatzMasLargo(hasta: int) -> int {
    var mejor = 0;
    var mejorPasos = 0;
    for (var i = 1; i <= hasta; i++) {
        var n = i;
        var pasos = 0;
        while (n != 1) {
            if (n % 2 == 0) {
                n = n / 2;
            } else {
                n = 3 * n + 1;
            }
            pasos = pasos + 1;
        }
        if (pasos > mejorPasos) {
            mejorPasos = pasos;
            mejor = i;
        }
    }
    return mejor;
};
