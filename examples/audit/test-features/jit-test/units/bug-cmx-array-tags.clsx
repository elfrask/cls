# Bug dev-2: ints en arrays anidados en records se imprimian como floats/punteros.
# `celulas: [1, 2, 3]` -> el tag del array debe ser compuesto (6<<8|kind).
function main(args: String[]) -> int {
    var props: Record<String, any> = {
        nombre: "Carlos",
        edad: 21,
        vivo: {state: true, celulas: [1, 2, 3]}
    };
    var maqueta = (<html {...props} />);
    print("props:", maqueta.props);
    return 0;
};
