var contador = 0;
const FACTOR = 2;

function incrementar() -> int {
    contador = contador + 1;
    return contador;
};

function main(args: String[]) -> int {
    print("contador inicial:", contador);
    incrementar();
    incrementar();
    print("contador:", contador);
    print("factor:", FACTOR);
    contador = contador + 100;
    print("contador final:", contador);
    var local = 5;
    print("local:", local);
    return 0;
};
