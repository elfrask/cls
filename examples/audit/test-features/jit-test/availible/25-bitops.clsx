function main(args: String[]) -> int {
    print("=== operadores bit a bit ===");
    print("5 ^ 3:", 5 ^ 3);
    print("1 << 4:", 1 << 4);
    print("16 >> 2:", 16 >> 2);
    print("~5:", ~5);
    print("xor doble:", (7 ^ 3) ^ 3);
    print("=== literal null ===");
    var n = null;
    print("null:", n);
    return 0;
};
