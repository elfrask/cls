# test-ffi-arity.clsx - Test del FFI con target propagation.
# Migracion dev-2: el emisor propaga target a imports de `extension`
# dentro de `when` (antes del fix, los statements compile-time
# dentro de `when` se perdian, invalidando el patron canonico
# `when (os: windows) { extension "ws2_32.dll" as C { ... } }`).
# Ver decision 002-ffi-arity-limit.md y extension-when.md.

when (os: windows) {
    extension "msvcrt.dll" as C {
        function strlen(s: CString) -> CInt;
        function atoi(s: CString) -> CInt;
    };
};

when (os: linux) {
    extension "libc.so.6" as C {
        function strlen(s: CString) -> CInt;
        function atoi(s: CString) -> CInt;
    };
};

when (os: macos) {
    extension "libSystem.B.dylib" as C {
        function strlen(s: CString) -> CInt;
        function atoi(s: CString) -> CInt;
    };
};

# Verificacion: el emisor propaga el target y solo emite la rama que
# matchea. Si llegamos aca, el `when`+`extension` funciona (antes del
# fix, strlen/atoi eran "Variable no definida").
function main(args: String[]) -> int {
    print("strlen('hola'):", strlen("hola"));
    print("atoi('42'):", atoi("42"));
    return 0;
};
