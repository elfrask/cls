import "fs" as fs;

function main(args: String[]) -> int {
    print("=== VFS Protocol Test ===");

    # Leer con app://
    var local = fs.readFile("app://test-vfs/.data.txt");
    print("app:// local:", local);

    # Escribir con app://
    fs.writeFile("app://test-vfs/vfs-out.txt", "Creado via app://!");
    var out = fs.readFile("app://test-vfs/vfs-out.txt");
    print("app:// out:", out);

    # Exists con app://
    var appExists = fs.exists("app://test-vfs/vfs-out.txt");
    print("app:// exists:", toString(appExists));

    # tmp:// test
    fs.writeFile("tmp://cls-test-tmp.txt", "Hello tmp://");
    var tmpExists = fs.exists("tmp://cls-test-tmp.txt");
    var tmpContent = fs.readFile("tmp://cls-test-tmp.txt");
    print("tmp:// exists:", toString(tmpExists));
    print("tmp:// content:", tmpContent);

    # ListDir con app://
    var files = fs.listDir("app://test-vfs");
    print("app:// listDir:", toString(files));

    return 0;
};
