import "lib" as lib;

function main(args: String[]) -> int {
    print("=== User Module Import Test ===");
    print("  greet('CLS'):", lib.greet("CLS"));
    print("  add(10, 20):", lib.add(10, 20));
    print("  VERSION:", lib.VERSION);
    print("  internal_secret:", lib.internal_secret);
    return 0;
}
