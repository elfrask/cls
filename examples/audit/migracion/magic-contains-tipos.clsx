class Caja {
    var v: int;
    function main(v: int) { me.v = v; }
    function __contains(n: int) -> bool { return n == me.v; }
    function __repr() -> String { return "Caja(" + toString(me.v) + ")"; }
};
function main(args: String[]) -> int {
    var c = Caja(5);
    print("in int:", 5 in c);        # true
    print("in str:", "x" in c);      # __contains(n: int) recibe string -> ?
    print("in float:", 5.0 in c);    # __contains(n: int) recibe float -> ?
    return 0;
}
