class Cmp {
    var v: int;
    function main(v: int) { me.v = v; }
    function __compare(o: Cmp) -> int { if (me.v < o.v) { return -1; } if (me.v > o.v) { return 1; } return 0; }
    function __repr() -> String { return "C(" + toString(me.v) + ")"; }
};
class AnyEq {
    var v: int;
    function main(v: int) { me.v = v; }
    function __equals(other: Any) -> bool { return me.v == 5; }
    function __repr() -> String { return "AE(" + toString(me.v) + ")"; }
};
function main(args: String[]) -> int {
    var c1 = Cmp(1);
    var c2 = Cmp(2);
    print("lt:", c1 < c2);             # true
    print("gt:", c1 > c2);             # false
    print("le:", c1 <= c1);            # true
    print("ge:", c1 >= c2);            # false
    var a = AnyEq(5);
    print("eq any-param:", a == AnyEq(7));  # param Any -> se permite, true
    print("eq int:", a == 9);               # param Any -> se permite
    return 0;
}
