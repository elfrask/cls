class Rango {
    var max: int;
    var i: int = 0;
    function main(max: int) { me.max = max; }
    function __iter() -> Rango { return me; }
    function __next() -> int {
        if (me.i >= me.max) { return null; }
        var v = me.i;
        me.i = me.i + 1;
        return v;
    }
};
class Lista {
    var items: int[];
    function main() { me.items = []; }
    function __iter() -> int[] { return me.items; }
    function push(x: int) { me.items.push(x); }
};
function main(args: String[]) -> int {
    print("break:");
    for each x in (Rango(5)) { if (x >= 2) { break; } print(x); }  # 0 1
    print("continue:");
    for each x in (Rango(5)) { if (x == 2) { continue; } print(x); }  # 0 1 3 4
    print("index:");
    for each v and i in (Rango(3)) { print(i, "->", v); }
    print("lista-array:");
    var l = Lista();
    l.push(7); l.push(8);
    for each x in (l) { print(x); }
    print("done");
    return 0;
}
