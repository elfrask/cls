class ConCall {
    var v: int;
    function main(v: int) { me.v = v; }
    function __call(x: int) -> int { return me.v + x; }
    function __set(i: int, val: int) { me.v = i + val; }
    function __repr() -> String { return "CC(" + toString(me.v) + ")"; }
};
function main(args: String[]) -> int {
    var c = ConCall(10);
    print("1:", c(5));         # 15
    print("2:", c(1, 2));      # aridad incorrecta -> ?
    return 0;
}
