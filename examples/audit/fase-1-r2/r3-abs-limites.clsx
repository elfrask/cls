# R3 (nuevo): math.abs float con import - limites
import "math" as math;
function main(args: String[]) -> int {
    print("abs(-2.5):", math.abs(-2.5));
    var x = math.abs(-2.5);
    print("x:", x);
    var y: float = math.abs(-2.5);
    print("y:", y);
    var arr = [math.abs(-2.5)];
    print("arr:", arr);
    print("is x:", x is Float);
    return 0;
};