# R1 (nuevo): limites nuevos de comparaciones mixtas int/float
function main(args: String[]) -> int {
    print("1 == 0.5:", 1 == 0.5);
    print("2.0 == 2:", 2.0 == 2);
    print("1 != 0.5:", 1 != 0.5);
    print("-3 < -2.5:", -3 < -2.5);
    print("-3 > -2.5:", -3 > -2.5);
    print("0 <= 0.0:", 0 <= 0.0);
    print("0 >= 0.0:", 0 >= 0.0);
    var x: int = 1;
    print("x == 0.5:", x == 0.5);
    print("x != 0.5:", x != 0.5);
    var f: float = 0.5;
    print("x < f:", x < f);
    print("x > f:", x > f);
    print("x <= f:", x <= f);
    print("0.5 > 1:", 0.5 > 1);
    return 0;
};
