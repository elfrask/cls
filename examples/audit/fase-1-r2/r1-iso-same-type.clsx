function main(args: String[]) -> int {
    var a: int = 2;
    var b: int = 2;
    print("int == int:", a == b);
    var x: float = 2.5;
    var y: float = 2.5;
    print("float == float:", x == y);
    var k: int = 3;
    var f: float = 3.0;
    print("f == k literal-eq:", f == k);
    return 0;
};
