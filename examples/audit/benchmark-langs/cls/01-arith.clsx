function main(args: String[]) -> int {
    var t0 = now();
    var N: int = 20000000;
    var sum: int = 0;
    var i: int = 0;
    for (i = 0; i < N; i++) {
        sum = sum + i;        # +
        sum = sum - 1;        # -
        sum = sum * 2;        # *
        sum = sum / 2;        # /
        sum = sum % 1000000;  # %
        if (sum < 0) { sum = 0; }  # comparacion
    }
    var t1 = now();
    print("arith_result:", sum);
    print("arith_ms:", t1 - t0);
    return 0;
}
