# STRESS: literales extremos 1e300 y 1e-300 y -1e300
function main(args: String[]) -> int {
    var a = 1e300;
    var b = 1e-300;
    var c = -1e300;
    var d = 1.7976931348623157e308;
    print("1e300:", a);
    print("1e-300:", b);
    print("-1e300:", c);
    print("max double:", d);
    print("suma:", a + b);
    return 0;
};
