function main(args: String[]) -> int {
    var r = random.random();
    print("random in [0,1):", r >= 0.0 && r < 1.0);
    var i = random.int(1, 6);
    print("int in [1,6]:", i >= 1 && i <= 6);
    var f = random.float(0.0, 10.0);
    print("float in [0,10):", f >= 0.0 && f < 10.0);
    var u = random.uuid();
    print("uuid len:", u.length);
    print("uuid:", u);
    return 0;
}
