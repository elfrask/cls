# C-2 isolate: igualdad mixta float/int en ambos ordenes
function main(args: String[]) -> int {
    var f: float = 2.0;
    print("f == 2 =", f == 2);
    print("f != 2 =", f != 2);
    print("2.5 == 2 =", 2.5 == 2);
    print("2 == 2.5 =", 2 == 2.5);
    print("2.0 == 2 =", 2.0 == 2);
    print("2 == 2.0 =", 2 == 2.0);
    return 0;
};
