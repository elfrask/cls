# C-2 edge cases: arrays, tuples, index write, comparisons
function main(args: String[]) -> int {
    var a = [1, 2.0];
    print("arr [1, 2.0] =", a);
    var t = (1.0, "x");
    print("tuple (1.0, 'x') =", t);
    var b = [1, 2, 3];
    b[0] = 2.5;
    print("b[0] = 2.5 ->", b);
    var f: float = 3.5;
    print("f > 0 =", f > 0);
    print("0.5 < 1 =", 0.5 < 1);
    print("0.5 == 0.5 =", 0.5 == 0.5);
    print("2.0 == 2 =", 2.0 == 2);
    return 0;
};
