# C-3: metodo protected invocado desde SUBCLASE debe permitirse
class Base {
    protected function secreta() -> int { return 7; }
    function main() { }
};
class Hijo: Base {
    function llamar() -> int { return me.secreta(); }
};
function main(args: String[]) -> int {
    var h = Hijo();
    print("desde subclase:", h.llamar());
    return 0;
};
