# C-2 isolate: aritmetica mixta int/float en ambos ordenes
function main(args: String[]) -> int {
    print("2.5 + 2 =", 2.5 + 2);
    print("2 + 2.5 =", 2 + 2.5);
    print("2.5 * 2 =", 2.5 * 2);
    print("2 * 2.5 =", 2 * 2.5);
    print("2.5 - 2 =", 2.5 - 2);
    print("2 - 2.5 =", 2 - 2.5);
    print("2.5 / 2 =", 2.5 / 2);
    print("2 / 2.5 =", 2 / 2.5);
    return 0;
};
