# R5: limites struct write - campo float, string en campo, struct anidado
structure Punto {
    x: int,
    y: float,
    nombre: String,
};
structure Caja {
    p: Punto,
    etiqueta: String,
};
function main(args: String[]) -> int {
    var p = Punto(1, 2.5, "a");
    print("antes:", p.x, p.y, p.nombre);
    p.y = 3.14;
    p.nombre = "texto";
    print("float:", p.y, "nombre:", p.nombre);
    var q = Caja(Punto(10, 20.5, "b"), "caja");
    q.p.x = 99;
    q.p.y = 88.5;
    print("anidado:", q.p.x, q.p.y, q.p.nombre, q.etiqueta);
    return 0;
};
