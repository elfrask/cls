# R6: metodo heredado SIN override - h.metodo() (antes "Metodo sin tipo WASM")
class Base {
    function saludar() -> String {
        return "hola desde base";
    };
    function sumar(a: int, b: int) -> int {
        return a + b;
    };
};
class Hija: Base {
};
function main(args: String[]) -> int {
    var h = Hija();
    print("saludar:", h.saludar());
    print("sumar:", h.sumar(20, 22));
    return 0;
};
