# X3 (CRITICO): colisión de nombres - variables locales fs/math/json/http vs
# módulos internos del nodo + imports con alias + enum namespaced + módulo->módulo
import "x3-libmod" as lib;
import "x3-mod-b" as lib2;
function main(args: String[]) -> int {
    # 1. Variables locales llamadas como módulos internos: index + compound
    var fs = [1.0, 2.0, 3.0];
    fs[1] += 2;
    print("fs local:", fs);                # [1, 4, 3]
    var math = [1.0, 2.0, 3.0];
    math[1] += 2;
    print("math local:", math);            # [1, 4, 3]
    var json = [1.0, 2.0, 3.0];
    json[0] *= 3;
    print("json local:", json);            # [3, 2, 3]
    var http = [1.0, 2.0, 3.0];
    http[2] -= 1;
    print("http local:", http);            # [1, 2, 2]
    # 2. Los módulos internos siguen funcionando tras la sombra local
    print("pow:", math.pow(2, 3));         # 8
    print("abs:", math.abs(-4));           # 4
    var parsed = json.parse('{"a": 1}');
    print("json parse:", parsed);          # {a: 1}
    # 3. Import con alias + enum namespaced
    print("saludar:", lib::saludar("mundo"));
    print("VERSION:", lib::VERSION);
    var c = lib::Color.Rojo;
    print("c:", c);
    print("c is:", c is lib::Color);
    print("c == verde:", c == lib::Color.Verde);
    # 4. Módulo -> módulo (lib2 usa lib)
    print("via:", lib2::saludarViaModulo("qa"));
    print("valor lib:", lib::valor());
    print("valor lib2:", lib2::valor());
    return 0;
};
