# X2a: compound index sobre array float - solo casos validos (a-h)
function main(args: String[]) -> int {
    var f1 = [2.5, 2.0, 3.0];
    f1[1] += 2;
    print("a:", f1);
    var f2 = [2.5, 2.0, 3.0];
    f2[1] -= 3;
    print("b:", f2);
    var f3 = [2.5, 2.0, 3.0];
    f3[1] *= 2;
    print("c:", f3);
    var f4 = [2.5, 2.0, 3.0];
    f4[1] /= 4;
    print("d:", f4);
    var f5 = [2.5, 2.0, 3.0];
    f5[1] %= 2;
    print("e:", f5);
    var k = 2;
    var f6 = [2.5, 2.0, 3.0];
    f6[1] *= k;
    print("f:", f6);
    var f7 = [2.5, 2.0, 3.0];
    f7[1] += 2.5;
    print("g:", f7);
    var a = [1, 2, 3];
    a[1] += 1;
    print("h:", a);
    return 0;
};
