# X2 (CRITICO): compound index write sobre array float - batería de límites
# Esperado: nada de "Módulo WASM inválido"; todos los casos ejecutan
function main(args: String[]) -> int {
    var f1 = [2.5, 2.0, 3.0];
    f1[1] += 2;                            # int literal en array float
    print("a:", f1);                       # [2.5, 4, 3]
    var f2 = [2.5, 2.0, 3.0];
    f2[1] -= 3;
    print("b:", f2);                       # [2.5, -1, 3]
    var f3 = [2.5, 2.0, 3.0];
    f3[1] *= 2;
    print("c:", f3);                       # [2.5, 4, 3]
    var f4 = [2.5, 2.0, 3.0];
    f4[1] /= 4;
    print("d:", f4);                       # [2.5, 0.5, 3]
    var f5 = [2.5, 2.0, 3.0];
    f5[1] %= 2;
    print("e:", f5);                       # [2.5, 0, 3]
    var k = 2;
    var f6 = [2.5, 2.0, 3.0];
    f6[1] *= k;                            # variable int
    print("f:", f6);                       # [2.5, 4, 3]
    var f7 = [2.5, 2.0, 3.0];
    f7[1] += 2.5;                          # literal float
    print("g:", f7);                       # [2.5, 4.5, 3]
    var a = [1, 2, 3];
    a[1] += 1;                             # int array + int -> sigue OK
    print("h:", a);                        # [1, 3, 3]
    var b = [1, 2, 3];
    b[1] += 1.5;                           # int array + float -> reportar comportamiento
    print("i:", b);
    return 0;
};
