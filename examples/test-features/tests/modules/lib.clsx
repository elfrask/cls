export enum Nivel {
    Bajo,
    Medio,
    Alto,
};

export class Contador {
    var valor: int = 0;
    function main(valor: int) {
        me.valor = valor;
    }
    function obtener() -> int {
        return me.valor;
    }
};

export structure Par {
    a: int,
    b: int,
};

export function suma(x: int, y: int) -> int {
    return x + y;
};

export var VERSION = "1.0.0";

function privada() -> String {
