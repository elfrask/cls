function main(args: String[]) -> int {
    var u = { a: 10, b: 20, c: 30 };
    print("a:", u["a"]);
    print("b:", u["b"]);
    print("len:", u.length);
    print("size:", u.size);
    print("has a:", u.has("a"));
    print("has x:", u.has("x"));
    u["d"] = 40;
    print("len tras set:", u.length);
    print("d:", u["d"]);
    var ks = u.keys();
    print("keys len:", len(ks));
    var vs = u.values();
    print("values len:", len(vs));
    return 0;
};
