# driver.clsx - Contrato de driver del ORM (agnostico al motor).
#
# La capa generica (`orm.clsx`) NO conoce SQLite: solo habla con un `Driver`.
# Un backend (SQLite hoy; MySQL/Postgres mañana) se implementa heredando de
# `Driver` y sobrescribiendo sus metodos. El ORM enruta las llamadas por la
# clase base y el JIT despacha al override de la subclase (polimorfismo).
#
# Valores: como el tipock del JIT no permite arrays heterogeneos ni `Any`,
# los valores viajan como `Cell` (tag + campos tipados). El ORM construye SQL
# estandar + placeholders `?` y enlaza Cells; el driver traduce cada Cell al
# tipo nativo del motor.
#
# Contrato que DEBE cumplir todo driver (ver README):
#   connect(path) -> int          abre una conexion (devuelve handle/0 ok)
#   close() -> int
#   exec(sql) -> int              ejecuta SQL sin resultados (rc 0 = ok)
#   query(sql) -> ResultSet       SELECT (sin parametros)
#   queryBind(sql, params) -> ResultSet   SELECT con placeholders `?`
#   prepare(sql) -> int           sentencia preparada (handle)
#   bind(stmt, idx, cell) -> int  enlaza el parametro idx (1-based)
#   step(stmt) -> int             1 fila / 0 fin / <0 error
#   resetStmt(stmt) -> int        reutiliza el stmt tras un step
#   finalizeStmt(stmt) -> int
#   lastId() -> int               last insert rowid
#   changes() -> int              filas afectadas por el ultimo DML
#   integrity() -> String         chequeo de integridad del motor
#   version() -> String
#
# El SQL que emite el ORM es estandar (no especifico de SQLite).

# --- Tipos de valor neutros al motor ---
export const KIND_NULL = 1;
export const KIND_INT = 2;
export const KIND_FLOAT = 3;
export const KIND_TEXT = 4;
export const KIND_BLOB = 5;

export class Cell {
    public var kind: int;
    public var i: int;
    public var f: float;
    public var s: String;      # TEXT, o hex del BLOB
    public function main(kind: int, i: int, f: float, s: String) {
        me.kind = kind;
        me.i = i;
        me.f = f;
        me.s = s;
    }
    public function isNull() -> bool { return me.kind == 1; }
    public function isInt() -> bool { return me.kind == 2; }
    public function isFloat() -> bool { return me.kind == 3; }
    public function isText() -> bool { return me.kind == 4; }
    public function isBlob() -> bool { return me.kind == 5; }
};

# WORKAROUND (regresion del lenguaje, ver findings/01): un `export const` de un
# modulo importado se lee como 0 cuando se referencia DENTRO de ese mismo modulo
# (el acceso `mod::CONST` desde otro modulo si da el valor correcto). Por eso las
# fabricas de abajo usan literales en vez de KIND_*. Los KIND_* exportados se
# conservan para el consumidor (donde si funcionan) y como documentacion.
export function cNull() -> Cell { return Cell(1, 0, 0.0, ""); }
export function cInt(v: int) -> Cell { return Cell(2, v, 0.0, ""); }
export function cFloat(v: float) -> Cell { return Cell(3, 0, v, ""); }
export function cText(v: String) -> Cell { return Cell(4, 0, 0.0, v); }
export function cBlob(hex: String) -> Cell { return Cell(5, 0, 0.0, hex); }

# --- Conjunto de resultados materializado (filas x columnas) ---
export class ResultSet {
    public var nrows: int;
    public var ncols: int;
    public var cols: String[];
    public var cells: Cell[];       # nrows * ncols en orden row-major
    public function main() {
        me.nrows = 0;
        me.ncols = 0;
        me.cols = [];
        me.cells = [];
    }
    public function at(r: int, c: int) -> Cell { return me.cells[r * me.ncols + c]; }
    public function getInt(r: int, c: int) -> int { return me.at(r, c).i; }
    public function getFloat(r: int, c: int) -> float { return me.at(r, c).f; }
    public function getText(r: int, c: int) -> String { return me.at(r, c).s; }
    public function colIndex(name: String) -> int {
        var k = 0;
        while (k < me.cols.length) {
            if (me.cols[k] == name) { return k; }
            k = k + 1;
        }
        return -1;
    }
};

# --- Clase base del driver (backend) ---
export class Driver {
    public function connect(path: String) -> int { return -1; }
    public function close() -> int { return -1; }
    public function exec(sql: String) -> int { return -1; }
    public function query(sql: String) -> ResultSet { return ResultSet(); }
    public function queryBind(sql: String, params: Cell[]) -> ResultSet { return ResultSet(); }
    public function prepare(sql: String) -> int { return -1; }
    public function bind(stmt: int, idx: int, cell: Cell) -> int { return -1; }
    public function step(stmt: int) -> int { return -1; }
    public function resetStmt(stmt: int) -> int { return -1; }
    public function finalizeStmt(stmt: int) -> int { return -1; }
    public function lastId() -> int { return -1; }
    public function changes() -> int { return -1; }
    public function integrity() -> String { return ""; }
    public function version() -> String { return ""; }
};
