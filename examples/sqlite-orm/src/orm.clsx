# orm.clsx - Capa generica del ORM (agnostica al motor).
#
# No contiene SQL especifico de SQLite: emite SQL estandar y delega la
# ejecucion en un `driver.clsx::Driver`. Agregar MySQL/Postgres = escribir un
# driver nuevo (subclase de `Driver`) sin tocar este archivo.
#
# Modelo de datos: los valores viajan como `Cell` (ver driver.clsx). Las
# condiciones WHERE se pasan como SQL estandar + parametros `?` (binding),
# nunca interpolando valores en el texto.

import "driver" as drv;

# Une items con un separador (sin `strings` del host: CLS puro).
function joinList(items: String[], sep: String) -> String {
    var out = "";
    var k = 0;
    while (k < items.length) {
        if (k > 0) { out = out + sep; }
        out = out + items[k];
        k = k + 1;
    }
    return out;
}

# "?, ?, ?" para n placeholders.
function placeholders(n: int) -> String {
    var out = "";
    var k = 0;
    while (k < n) {
        if (k > 0) { out = out + ", "; }
        out = out + "?";
        k = k + 1;
    }
    return out;
}

# "a = ?, b = ?" para una lista de columnas.
function assignList(cols: String[]) -> String {
    var out = "";
    var k = 0;
    while (k < cols.length) {
        if (k > 0) { out = out + ", "; }
        out = out + cols[k] + " = ?";
        k = k + 1;
    }
    return out;
}

# " ORDER BY ... LIMIT n OFFSET m" (limit < 0 = sin limite).
function tailClause(orderBy: String, limit: int, offset: int) -> String {
    var out = "";
    if (orderBy != "") { out = out + " ORDER BY " + orderBy; }
    if (limit >= 0) {
        out = out + " LIMIT " + str(limit);
        if (offset > 0) { out = out + " OFFSET " + str(offset); }
    }
    return out;
}

export class Orm {
    var d: drv::Driver;
    function main(driver: drv::Driver) { me.d = driver; }

    function exec(sql: String) -> int { return me.d.exec(sql); }
    function query(sql: String) -> drv::ResultSet { return me.d.query(sql); }
    function begin() -> int { return me.d.exec("BEGIN"); }
    function commit() -> int { return me.d.exec("COMMIT"); }
    function rollback() -> int { return me.d.exec("ROLLBACK"); }
    function integrity() -> String { return me.d.integrity(); }
    function engineVersion() -> String { return me.d.version(); }
    function lastId() -> int { return me.d.lastId(); }
    function changes() -> int { return me.d.changes(); }

    function createTable(table: String, colDefs: String[]) -> int {
        return me.d.exec("CREATE TABLE " + table + " (" + joinList(colDefs, ", ") + ")");
    }

    function dropTable(table: String) -> int {
        return me.d.exec("DROP TABLE IF EXISTS " + table);
    }

    # INSERT de una fila; devuelve el last_insert_rowid.
    function insert(table: String, cols: String[], vals: drv::Cell[]) -> int {
        var sql = "INSERT INTO " + table + " (" + joinList(cols, ", ") +
                  ") VALUES (" + placeholders(cols.length) + ")";
        var s = me.d.prepare(sql);
        var k = 0;
        while (k < vals.length) { me.d.bind(s, k + 1, vals[k]); k = k + 1; }
        me.d.step(s);
        var id = me.d.lastId();
        me.d.finalizeStmt(s);
        return id;
    }

    # INSERT de muchas filas en UNA transaccion con el mismo stmt preparado.
    function insertBatch(table: String, cols: String[], rows: drv::Cell[][]) -> int {
        var sql = "INSERT INTO " + table + " (" + joinList(cols, ", ") +
                  ") VALUES (" + placeholders(cols.length) + ")";
        var s = me.d.prepare(sql);
        me.d.exec("BEGIN");
        var n = 0;
        while (n < rows.length) {
            var row = rows[n];
            var k = 0;
            while (k < row.length) { me.d.bind(s, k + 1, row[k]); k = k + 1; }
            me.d.step(s);
            me.d.resetStmt(s);
            n = n + 1;
        }
        me.d.exec("COMMIT");
        me.d.finalizeStmt(s);
        return n;
    }

    # --- Bulk streaming (una fila por vez; evita mantener Cell[][] en memoria) ---
    function prepareInsert(table: String, cols: String[]) -> int {
        var sql = "INSERT INTO " + table + " (" + joinList(cols, ", ") +
                  ") VALUES (" + placeholders(cols.length) + ")";
        return me.d.prepare(sql);
    }
    function bulkRow(stmt: int, vals: drv::Cell[]) -> int {
        var k = 0;
        while (k < vals.length) { me.d.bind(stmt, k + 1, vals[k]); k = k + 1; }
        var rc = me.d.step(stmt);
        me.d.resetStmt(stmt);
        return rc;
    }
    function finishInsert(stmt: int) -> int { return me.d.finalizeStmt(stmt); }

    # DML con parametros (UPDATE/DELETE); devuelve filas afectadas.
    function runDml(sql: String, params: drv::Cell[]) -> int {
        var s = me.d.prepare(sql);
        var k = 0;
        while (k < params.length) { me.d.bind(s, k + 1, params[k]); k = k + 1; }
        me.d.step(s);
        me.d.finalizeStmt(s);
        return me.d.changes();
    }

    function selectAll(table: String, orderBy: String) -> drv::ResultSet {
        return me.d.query("SELECT * FROM " + table + tailClause(orderBy, -1, 0));
    }

    function selectWhere(table: String, whereSql: String, params: drv::Cell[],
                         orderBy: String, limit: int, offset: int) -> drv::ResultSet {
        var sql = "SELECT * FROM " + table + " WHERE " + whereSql +
                  tailClause(orderBy, limit, offset);
        return me.d.queryBind(sql, params);
    }

    function findById(table: String, id: int) -> drv::ResultSet {
        var p: drv::Cell[] = [drv::cInt(id)];
        return me.d.queryBind("SELECT * FROM " + table + " WHERE id = ?", p);
    }

    function update(table: String, setCols: String[], setVals: drv::Cell[],
                    whereSql: String, whereParams: drv::Cell[]) -> int {
        var sql = "UPDATE " + table + " SET " + assignList(setCols) +
                  " WHERE " + whereSql;
        var p: drv::Cell[] = [];
        var k = 0;
        while (k < setVals.length) { p.push(setVals[k]); k = k + 1; }
        k = 0;
        while (k < whereParams.length) { p.push(whereParams[k]); k = k + 1; }
        return me.runDml(sql, p);
    }

    function deleteWhere(table: String, whereSql: String, params: drv::Cell[]) -> int {
        return me.runDml("DELETE FROM " + table + " WHERE " + whereSql, params);
    }

    function count(table: String) -> int {
        var rs = me.d.query("SELECT COUNT(*) FROM " + table);
        return rs.getInt(0, 0);
    }

    function countWhere(table: String, whereSql: String, params: drv::Cell[]) -> int {
        var rs = me.d.queryBind("SELECT COUNT(*) FROM " + table + " WHERE " + whereSql, params);
        return rs.getInt(0, 0);
    }
};
