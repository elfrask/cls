# Negativo B2: `match … is` sobre una unión de builtins (`int | String`).
# Los builtins no tienen identidad de runtime: el typeck lo rechaza.
alias M = int | String;

function main(args: String[]) -> int {
    var v: M = 5;
    var s: String = match (v) is { String -> "str", int -> "int" };
    print(s);
    return 0;
};
