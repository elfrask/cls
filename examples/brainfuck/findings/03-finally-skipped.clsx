# REGRESION 3: el bloque `finally` NO se ejecuta en los casos normales:
#   - en salida normal del `try` (sin excepcion)
#   - despues de un `catch` local que captura la excepcion
# Solo se ejecuta cuando la excepcion PROPAGA fuera del `try` (sin catch local).
#
# Comando:
#   target\debug\clx.exe run examples\brainfuck\findings\03-finally-skipped.clsx
#
# Esperado:
#   try
#   finally
#   catch
#   finally
#   n=3
# Obtenido:
#   try
#   catch
#   n=1      (el finally nunca corre)

function main(args: String[]) -> int {
    try {
        print("try");
    } finally {
        print("finally");          # NO se imprime
    }

    try {
        throw("x");
    } catch (e) {
        print("catch");
    } finally {
        print("finally");          # NO se imprime
    }

    var n = 0;
    try {
        n = 1;
    } finally {
        n = 3;                     # NO se ejecuta -> n queda 1
    }
    print("n=${n}");
    return 0;
};
