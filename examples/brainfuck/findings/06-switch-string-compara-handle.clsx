# Repro minimo: `switch` sobre un String compara el HANDLE (puntero), no el
# contenido. Solo "acierta" si el valor es el MISMO literal internado que el
# `case`; un String construido en runtime (concatenacion, substring `s[i]`) con
# el mismo contenido NO matchea y cae al `default`.
#
# Esperado: las tres lineas deberian imprimir la misma clasificacion.
# Obtenido: solo el literal directo coincide.
#
#   target\debug\clx.exe run examples\brainfuck\findings\06-switch-string-compara-handle.clsx
#
# Causa: el emisor `emit_switch` (cls-core/src/backend/wasm/emitter/statements.rs)
# compara con `push_eq(WasTy::I64)`, que es `i64.eq` sobre el handle del String,
# en vez de usar el helper de contenido `__intr_str_eq` (el que usa `==`).

function klass(x: String) -> String {
    switch (x) {
        case (">") { return "MOVE"; }
        case ("+") { return "INC"; }
        case default { return "?"; }
    }
    return "?";
}

function main(args: String[]) -> int {
    print("literal: " + klass(">"));
    var s = ">" + "";
    print("concat : " + klass(s));
    var prog = ">+";
    print("substr : " + klass(prog[0]));
    return 0;
}
