# Contraste de la regresion 1: el MISMO FFI, pero envuelto en `when`, funciona.
#
#   target\debug\clx.exe run examples\brainfuck\findings\01b-ffi-when-works.clsx
# Esperado/obtenido: 4

when (os: windows) {
    extension "msvcrt.dll" as C {
        function strlen(s: CString) -> CLong;
    };
};

function main(args: String[]) -> int {
    print(strlen("hola"));
    return 0;
};
