# bf.clsx - Interprete de Brainfuck en CLS puro + puente FFI al oraculo C.
#
# Exporta:
#   bf_run_cls(prog, input) -> int[]   interprete BF escrito en CLS puro
#   bf_oracle(prog, input)  -> int[]   interprete de referencia (C, via FFI)
#
# La I/O de archivos y el codigo de byte se consumen de los modulos compartidos
# de /modules (regla examples/patrones.md §11.5):
#   - `io`    : readText / readBytes (FFI)
#   - `bytes` : ord (codigo de byte, ahora sin FFI: intrinseco) + firstDiff
# El unico FFI propio de esta prueba es el ORACULO BF (bf_run en oracle/bf.dll).
#
# La semantica de ambos interpretes es identica:
#   - tape de 30000 celdas u8, puntero con wrap circular
#   - `+`/`-` con wrap modulo 256
#   - `,` = byte de entrada, 0 en EOF
#   - saltos `[` `]` por tabla de parejas precalculada
#
# `extension` a nivel superior (sin `when`): el emisor WASM ya soporta
# declaraciones nativas a nivel de modulo (fix del panic del emisor).

import "bytes" as bytes;

extension "examples/brainfuck/oracle/bf.dll" as C {
    function bf_run(program: CString, input: CString) -> CArray;
};

# Opcode de Brainfuck (una variante por instruccion). `Invalid` marca un
# caracter que no es instruccion (comentario/espacio) y se descarta al filtrar.
enum Op {
    Invalid,
    Move,
    Left,
    Inc,
    Dec,
    Out,
    In,
    Loop,
    End,
};

# Codigo de instruccion a partir del caracter (String de 1 byte); `Op.Invalid`
# si el caracter no es una instruccion. `match` modo valor compara CONTENIDO de
# String (igual que `switch` desde el fix del finding 06).
function cmd_of(ch: String) -> Op {
    return match (ch) in {
        ">" -> Op.Move,
        "<" -> Op.Left,
        "+" -> Op.Inc,
        "-" -> Op.Dec,
        "." -> Op.Out,
        "," -> Op.In,
        "[" -> Op.Loop,
        "]" -> Op.End,
        default -> Op.Invalid,
    };
}

# Interprete en CLS puro. Devuelve los bytes de salida como int[].
export function bf_run_cls(prog: String, input: String) -> int[] {
    # 1. Filtrar a un arreglo de opcodes (descarta comentarios/espacios).
    #    Se itera el programa por caracter (`prog[i]` -> String de 1 byte).
    var cmds: Op[] = [];
    for (var i = 0; i < prog.length; i++) {
        var c = cmd_of(prog[i]);
        if (c != Op.Invalid) { cmds.push(c); }
    }
    var m = cmds.length;

    # 2. Tabla de parejas de brackets.
    var jump: int[] = [];
    for (var k = 0; k < m; k++) { jump.push(-1); }
    var stack: int[] = [];
    for (var k = 0; k < m; k++) {
        match (op <- cmds[k]) {
            Loop -> {
                stack.push(k);
            },
            End -> {
                if (stack.length > 0) {
                    var o = stack[stack.length - 1];
                    stack.pop();
                    jump[o] = k;
                    jump[k] = o;
                }
            },
            default -> {},
        }
    }

    # 3. Tape de 30000 celdas.
    var tape: int[] = [];
    for (var t = 0; t < 30000; t++) { tape.push(0); }

    # 4. Bucle principal.
    var out: int[] = [];
    var tp = 0;
    var ip = 0;
    # Bytes de entrada como Char[] (unidad de 1 byte); su codigo con bytes::ord.
    var inbytes = input.toChar();
    var inlen = inbytes.length;
    for (var pc = 0; pc < m; pc++) {
        match (op <- cmds[pc]) {
            Move -> {
                tp = tp + 1;
                if (tp >= 30000) { tp = 0; }
            },
            Left -> {
                tp = tp - 1;
                if (tp < 0) { tp = 29999; }
            },
            Inc -> {
                tape[tp] = (tape[tp] + 1) % 256;
            },
            Dec -> {
                tape[tp] = (tape[tp] + 255) % 256;
            },
            Out -> {
                out.push(tape[tp]);
            },
            In -> {
                if (ip < inlen) {
                    tape[tp] = bytes::ord(inbytes[ip]);
                    ip = ip + 1;
                } else {
                    tape[tp] = 0;
                }
            },
            Loop -> {
                if (tape[tp] == 0) { pc = jump[pc]; }
            },
            End -> {
                if (tape[tp] != 0) { pc = jump[pc]; }
            },
            default -> {},
        }
    }
    return out;
}

# Interprete de referencia (C, via FFI). Mismo contrato que bf_run_cls.
export function bf_oracle(prog: String, input: String) -> int[] {
    return bf_run(prog, input);
}
