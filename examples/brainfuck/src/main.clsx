# main.clsx - Runner de la prueba Brainfuck (CLS puro vs oraculo C).
#
# Para cada programa `.bf`:
#   1. corre el interprete en CLS puro (bf::bf_run_cls)
#   2. corre el oraculo C por FFI (bf::bf_oracle)
#   3. compara ambos byte a byte contra el `.out` dorado
# Reporta longitudes, primera divergencia y tiempos. Exit != 0 si algo difiere.
#
# La I/O de archivos y el codigo de byte se consumen de /modules (regla
# examples/patrones.md §11.5): `io` (readText/readBytes) y `bytes` (firstDiff +
# hexEncode para el reporte). No se copia codigo.
#
# Uso (desde la raiz del repo, CWD = raiz):
#   target\debug\clx.exe run examples\brainfuck\src\main.clsx --add-path-module=modules
#
# El directorio de programas es relativo a la raiz del repo (igual que la ruta
# del .dll del oraculo declarada en bf.clsx).

import "bf" as bf;
import "io" as io;
import "bytes" as bytes;

function pad(s: String, n: int) -> String {
    var out = s;
    while (out.length < n) { out = out + " "; }
    return out;
}

# Hex (con espacios) de los primeros hasta 16 bytes, para reportar divergencias.
function hex16(a: int[]) -> String {
    var out = "";
    var n = a.length;
    if (n > 16) { n = 16; }
    for (var i = 0; i < n; i++) {
        var one: Char[] = [char(a[i])];
        out = out + bytes::hexEncode(one);
        if (i + 1 < n) { out = out + " "; }
    }
    return out;
}

function main(args: String[]) -> int {
    var root = "examples/brainfuck/programs/";
    var names: String[] = ["hello", "wrap", "torture", "bench", "ptr", "cat"];
    # Entrada para `,` por programa (cat usa el contenido de cat.in).
    var inputs: String[] = ["", "", "", "", "", io::readText(root + "cat.in")];

    print("=== Brainfuck: CLS puro vs oraculo C (FFI) ===");
    var failures = 0;
    for (var i = 0; i < names.length; i++) {
        var name = names[i];
        var path = root + name + ".bf";
        var prog = io::readText(path);

        if (prog.length == 0) {
            # Leer el .bf falló (p.ej. el .dll del oráculo no cargó). No se
            # puede validar: cuenta como fallo para que el test no de falso OK.
            print("  [FAIL] " + name + ": no se pudo leer " + path);
            failures = failures + 1;
            continue;
        }

        # --- interprete CLS ---
        var t0 = now();
        var cls_out = bf::bf_run_cls(prog, inputs[i]);
        var t1 = now();

        # --- oraculo C ---
        var c_out = bf::bf_oracle(prog, inputs[i]);
        var t2 = now();

        # --- dorado (.out) ---
        var golden = io::readBytes(root + name + ".out");

        var d_cc = bytes::firstDiff(cls_out, c_out);
        var d_cg = bytes::firstDiff(cls_out, golden);

        var ok = (d_cc == -2) && (d_cg == -2);
        var tag = ok ? " OK " : "FAIL";
        print("  [${tag}] ${pad(name, 9)} len cls=${cls_out.length} oracle=${c_out.length} golden=${golden.length} | t_cls=${t1 - t0}ms t_c=${t2 - t1}ms");

        if (!ok) {
            if (d_cc != -2) {
                print("          divergencia CLS vs C en indice ${d_cc}");
                print("          cls : " + hex16(cls_out));
                print("          C   : " + hex16(c_out));
            }
            if (d_cg != -2) {
                print("          divergencia CLS vs golden en indice ${d_cg}");
                print("          cls   : " + hex16(cls_out));
                print("          golden: " + hex16(golden));
            }
            failures = failures + 1;
        }
    }

    # --- [EXPERIMENTAL] `io::readChars` (buffer `Char[]`) vs `io::readBytes` (int[]) ---
    # Prueba del modelo Char-para-buffers: el mismo `.out` leido de las dos
    # formas debe coincidir byte a byte. NO reemplaza la ruta `int[]`.
    var exp_fail = 0;
    for each name and j in (names) {
        var gp = root + name + ".out";
        var gbytes = io::readBytes(gp);
        var gchars = io::readChars(gp);
        var okc = (gchars.length == gbytes.length);
        if (okc) {
            for (var q = 0; q < gchars.length; q++) {
                if (ord(gchars[q]) != gbytes[q]) { okc = false; break; }
            }
        }
        if (!okc) { exp_fail = exp_fail + 1; }
    }
    if (exp_fail == 0) {
        print("EXPERIMENTAL readChars: OK (Char[] == int[] byte a byte en los 6 goldens)");
    } else {
        print("EXPERIMENTAL readChars: ${exp_fail} divergencia(s)");
        failures = failures + exp_fail;
    }

    if (failures == 0) {
        print("RESULTADO: OK (todos los programas coinciden byte a byte)");
        return 0;
    }
    print("RESULTADO: ${failures} programa(s) con divergencia");
    return 1;
}
