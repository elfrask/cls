function main(args) -> int {
    print("=== Stdlib como módulos ===");

    # Módulo math
    print("math.abs(-5):", math.abs(-5));
    print("math.sqrt(16):", math.sqrt(16));
    print("math.PI:", math.PI);

    # Módulo fs
    print("fs.exists('hello.ccls'):", fs.exists("hello.ccls"));
    var content = fs.readFile("hello.ccls");
    print("fs.readFile:", len(content), "bytes");

    # Módulo json
    var obj = json.parse('{"name": "CLS"}');
    print("json.parse:", obj);
    print("json.stringify:", json.stringify(obj));

    return 0;
}
