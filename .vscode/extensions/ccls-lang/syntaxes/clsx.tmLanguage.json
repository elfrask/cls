{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "Gramática de CLS basada en la estructura de tsx.examples.tmLanguage.json: declaraciones, expresiones, type parameters, regiones de tipo y separación tag/children para CMX. Adaptada al léxico real de CLS (comentarios #, ->/<-/=>, comparaciones < y >, genéricos y CMX)."
  ],
  "name": "CLS",
  "scopeName": "source.clsx",
  "patterns": [
    {
      "include": "#directives"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#generic-call"
    },
    {
      "include": "#cmx"
    },
    {
      "include": "#type-declarations"
    },
    {
      "include": "#methods"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#var-decl"
    },
    {
      "include": "#type-annotations"
    },
    {
      "include": "#extension"
    },
    {
      "include": "#when"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#type-primitives"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "directives": {
      "patterns": [
        {
          "name": "meta.directive.ccls",
          "match": "\\A#!ccls(?:\\s+.*)?$"
        },
        {
          "name": "meta.directive.config.ccls",
          "match": "^#config\\s*\\([^)]*\\)"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ccls",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ccls",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.ccls",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ccls",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.ccls",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.ccls",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.ccls",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "variable.other.interpolation.ccls",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "meta.interpolation.ccls",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.begin.ccls"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.end.ccls"
            }
          },
          "patterns": [
            {
              "include": "$self"
            },
            {
              "include": "#embedded-expression"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ccls",
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.float.ccls",
          "match": "\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ccls",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ccls",
          "match": "\\b(if|elif|then|else|while|loop|for|each|in|switch|case|match|default|try|catch|finally|throw|return|break|continue|with|and|or|not|is|when|extension)\\b"
        },
        {
          "name": "keyword.declaration.ccls",
          "match": "\\b(function|void|method|var|const|let)\\b"
        },
        {
          "name": "keyword.structure.ccls",
          "match": "\\b(class|structure|interface|module|namespace|enum)\\b"
        },
        {
          "name": "keyword.alias.ccls",
          "match": "\\balias\\b"
        },
        {
          "name": "keyword.import.ccls",
          "match": "\\b(import|from|as|include|export)\\b"
        },
        {
          "name": "keyword.modifier.ccls",
          "match": "\\b(public|private|protected|static|readonly|global|async|await|sync|macro|extends|implements)\\b"
        },
        {
          "name": "keyword.self.ccls",
          "match": "\\b(me|super)\\b"
        },
        {
          "name": "keyword.config.ccls",
          "match": "\\bconfig\\b"
        }
      ]
    },
    "type-primitives": {
      "patterns": [
        {
          "name": "storage.type.primitive.ccls",
          "match": "\\b(String|Int|Integer|Float|Bool|Boolean|Char|Character|Unknown|Null|Void|Empty|Value|JSON|Json|Cmx|CMX|Any)\\b"
        },
        {
          "name": "storage.type.numeric.ccls",
          "match": "\\b(i8|i16|i32|i64|f32|f64|int|float|str|bool|char|array)\\b"
        },
        {
          "name": "storage.type.container.ccls",
          "match": "\\b(Array|Tuple|Record|Map|Struct)\\b"
        },
        {
          "name": "storage.type.native.ccls",
          "match": "\\b(CString|CPtr|CInt|CUInt|CShort|CUShort|CLong|CULong|CChar|CUChar|CFloat|CDouble|CStruct|CRecord|CArray)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ccls",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.ccls",
          "match": "\\b(null|unknown)\\b"
        }
      ]
    },
    "type-expression": {
      "patterns": [
        {
          "include": "#generic"
        },
        {
          "include": "#type-primitives"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#type-shape"
        },
        {
          "include": "#type-tuple"
        },
        {
          "include": "#type-array"
        },
        {
          "include": "#type-fun"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#comments"
        },
        {
          "name": "keyword.operator.phantom.ccls",
          "match": "!(?=[A-Za-z_])"
        },
        {
          "name": "keyword.operator.union.ccls",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.intersection.ccls",
          "match": "&"
        },
        {
          "name": "keyword.operator.arrow.ccls",
          "match": "->"
        },
        {
          "name": "keyword.operator.fun-type.ccls",
          "match": "\\bfun\\b"
        },
        {
          "name": "entity.name.type.ccls",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.parameter.type-param.ccls",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.ccls",
          "match": "[,:=]"
        },
        {
          "name": "punctuation.section.brackets.ccls",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.ccls",
          "match": "[()]"
        }
      ]
    },
    "generic": {
      "name": "meta.type.generic.ccls",
      "begin": "<",
      "end": ">",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.begin.ccls"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.end.ccls"
        }
      },
      "patterns": [
        {
          "include": "#type-expression"
        },
        {
          "name": "punctuation.separator.ccls",
          "match": ","
        },
        {
          "name": "keyword.operator.assignment.ccls",
          "match": "="
        }
      ]
    },
    "generic-call": {
      "name": "meta.type.generic.ccls",
      "begin": "(?x)\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(<)(?=[A-Za-z_(\\[{!](?:[^<>\\n]|<[^<>\\n]*>)*>\\s*\\()",
      "end": ">",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.call.ccls"
        },
        "2": {
          "name": "punctuation.definition.typearguments.begin.ccls"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.typearguments.end.ccls"
        }
      },
      "patterns": [
        {
          "include": "#type-expression"
        },
        {
          "name": "punctuation.separator.ccls",
          "match": ","
        }
      ]
    },
    "type-annotations": {
      "patterns": [
        {
          "name": "meta.type.annotation.ccls",
          "begin": "(?<!::)(?<=:)(?=\\s*(?:[A-Z_(\\[{!]|\\b(?:int|float|str|bool|char|String|Int|Float|Bool|Boolean|Char|Value|JSON|Cmx|CMX|Array|Tuple|Record|CString|CInt|CLong|CStruct|CRecord|CArray)\\b))",
          "end": "(?=\\s*(?:=|,|\\)|;|\\{|\\}|<-|\\]))",
          "patterns": [
            {
              "include": "#type-expression"
            },
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "type-shape": {
      "name": "meta.type.shape.ccls",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.ccls"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.ccls"
        }
      },
      "patterns": [
        {
          "name": "variable.other.property.ccls",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*:)"
        },
        {
          "include": "#type-annotations"
        },
        {
          "include": "#type-expression"
        },
        {
          "include": "#comments"
        },
        {
          "name": "punctuation.separator.ccls",
          "match": ","
        }
      ]
    },
    "type-tuple": {
      "name": "meta.type.tuple.ccls",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.parens.begin.ccls"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.ccls"
        }
      },
      "patterns": [
        {
          "include": "#type-expression"
        },
        {
          "include": "#comments"
        },
        {
          "name": "punctuation.separator.ccls",
          "match": ","
        }
      ]
    },
    "type-array": {
      "patterns": [
        {
          "name": "meta.type.array.ccls",
          "match": "\\[\\]",
          "captures": {
            "0": {
              "name": "punctuation.section.brackets.ccls"
            }
          }
        },
        {
          "name": "meta.type.access.ccls",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.brackets.begin.ccls"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.brackets.end.ccls"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            }
          ]
        }
      ]
    },
    "type-fun": {
      "name": "meta.type.fun.ccls",
      "begin": "\\bfun\\s*\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.fun-type.ccls"
        }
      },
      "patterns": [
        {
          "include": "#type-expression"
        },
        {
          "include": "#comments"
        },
        {
          "name": "punctuation.separator.ccls",
          "match": ","
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "name": "meta.type.declaration.ccls",
          "begin": "\\b(class|structure|interface|alias|enum|module|namespace)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "(?=\\{|;)",
          "beginCaptures": {
            "1": {
              "name": "keyword.structure.ccls"
            },
            "2": {
              "name": "entity.name.type.ccls"
            }
          },
          "patterns": [
            {
              "include": "#generic"
            },
            {
              "include": "#type-expression"
            },
            {
              "include": "#type-annotations"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.ccls",
          "begin": "\\b(function|void|method)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "(?=\\{|;)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ccls"
            },
            "2": {
              "name": "entity.name.function.ccls"
            }
          },
          "patterns": [
            {
              "include": "#function-params"
            },
            {
              "include": "#generic"
            },
            {
              "name": "variable.parameter.ccls",
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=[:),=])"
            },
            {
              "include": "#type-annotations"
            },
            {
              "include": "#return-type"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#type-primitives"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "methods": {
      "patterns": [
        {
          "name": "meta.method.ccls",
          "begin": "\\b(public|private|protected|static|readonly|async)\\s+(function|void|method)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "(?=\\{|;)",
          "beginCaptures": {
            "1": {
              "name": "keyword.modifier.ccls"
            },
            "2": {
              "name": "keyword.declaration.ccls"
            },
            "3": {
              "name": "entity.name.function.method.ccls"
            }
          },
          "patterns": [
            {
              "include": "#function-params"
            },
            {
              "include": "#generic"
            },
            {
              "name": "variable.parameter.ccls",
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=[:),=])"
            },
            {
              "include": "#type-annotations"
            },
            {
              "include": "#return-type"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#type-primitives"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "return-type": {
      "name": "meta.return-type.ccls",
      "begin": "(->)\\s*",
      "end": "(?=\\{|;)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.arrow.ccls"
        }
      },
      "patterns": [
        {
          "include": "#type-expression"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "var-decl": {
      "patterns": [
        {
          "name": "meta.var-decl.ccls",
          "begin": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "(?=;)|$",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ccls"
            },
            "2": {
              "name": "variable.other.constant.ccls"
            }
          },
          "patterns": [
            {
              "include": "#type-annotations"
            },
            {
              "include": "#generic-call"
            },
            {
              "include": "#cmx"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#function-call"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#type-primitives"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "meta.var-decl.ccls",
          "begin": "\\b(var|let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "(?=;)|$",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ccls"
            },
            "2": {
              "name": "variable.other.ccls"
            }
          },
          "patterns": [
            {
              "include": "#type-annotations"
            },
            {
              "include": "#generic-call"
            },
            {
              "include": "#cmx"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#function-call"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#type-primitives"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "extension": {
      "patterns": [
        {
          "name": "meta.extension.ccls",
          "match": "\\b(extension)\\s+(\"[^\"]*\")(\\s+as\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)?\\s*\\{",
          "captures": {
            "1": {
              "name": "keyword.control.ccls"
            },
            "2": {
              "name": "string.quoted.double.ccls"
            },
            "3": {
              "name": "keyword.import.ccls"
            },
            "4": {
              "name": "storage.type.native.ccls"
            }
          }
        }
      ]
    },
    "when": {
      "patterns": [
        {
          "name": "meta.when.ccls",
          "begin": "\\b(when)\\s+",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.ccls"
            }
          },
          "end": "(?=\\{)",
          "patterns": [
            {
              "include": "#target-condition"
            }
          ]
        }
      ]
    },
    "target-condition": {
      "patterns": [
        {
          "name": "keyword.operator.selector.ccls",
          "match": "\\b(os|arch|abi|platform|target)\\s*:"
        },
        {
          "name": "keyword.control.platform.ccls",
          "match": "\\b(windows|linux|macos|none|bare-metal|freebsd|cls-arch|x86_64|arm64|aarch64|arm|riscv32|riscv64|avr)\\b"
        },
        {
          "name": "keyword.operator.logical.ccls",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "string.quoted.double.ccls",
          "match": "\"[^\"]*\""
        },
        {
          "name": "punctuation.section.parens.ccls",
          "match": "[()!]"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function.call.ccls",
          "match": "\\b(?!(?:fun|void|method|if|elif|else|throw|case|while|for|return|switch|catch|import|from|as|include|new|with|in|when|default|extension|and|or|not|match|each|is)\\b)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.spread.ccls",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.arrow.ccls",
          "match": "->|<-|=>"
        },
        {
          "name": "keyword.operator.namespace.ccls",
          "match": "::"
        },
        {
          "name": "keyword.operator.power.ccls",
          "match": "\\*\\*"
        },
        {
          "name": "keyword.operator.increment.ccls",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.assignment.compound.ccls",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.shift.ccls",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.ccls",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.ccls",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.range.ccls",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.ccls",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.arithmetic.ccls",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.logical.single.ccls",
          "match": "[&|!?~@^:]"
        },
        {
          "name": "keyword.operator.assignment.ccls",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.begin.ccls",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.ccls",
          "match": "\\)"
        },
