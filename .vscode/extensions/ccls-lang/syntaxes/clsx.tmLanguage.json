{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CLS",
  "scopeName": "source.clsx",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#cmx"
    },
    {
      "include": "#meta-directives"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ccls",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ccls",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.ccls",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ccls",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ccls",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.ccls",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "variable.other.interpolation.ccls",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "meta.interpolation.ccls",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.ccls" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.ccls" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ccls",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ccls",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ccls",
          "match": "\\b(if|elif|then|else|while|loop|for|switch|case|default|try|catch|finally|throw|return|break|continue|with|each|in|and)\\b"
        },
        {
          "name": "keyword.declaration.ccls",
          "match": "\\b(function|fun|void|method|var|const|let)\\b"
        },
        {
          "name": "keyword.structure.ccls",
          "match": "\\b(class|structure|interface|module|namespace)\\b"
        },
        {
          "name": "keyword.import.ccls",
          "match": "\\b(import|from|as|include|export)\\b"
        },
        {
          "name": "keyword.modifier.ccls",
          "match": "\\b(public|private|static|global|async|await|sync|macro)\\b"
        },
        {
          "name": "keyword.self.ccls",
          "match": "\\bme\\b"
        },
        {
          "name": "keyword.config.ccls",
          "match": "\\bconfig\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.ccls",
          "match": "\\b(Int|Integer|Float|String|Bool|Boolean|Char|Character|Any|Unknown|Null|Void|Empty|fun|Cmx|cmx|Record)\\b"
        },
        {
          "name": "storage.type.numeric.ccls",
          "match": "\\b(i8|i16|i32|i64|f32|f64|int|float|str|bool|char|any|array|Array)\\b"
        },
        {
          "name": "storage.type.function.ccls",
          "match": "\\bfun\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.ccls",
          "begin": "\\b(function|void|method|fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "end": "(?<=\\))",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.ccls" },
            "2": { "name": "entity.name.function.ccls" },
            "3": { "name": "punctuation.section.parens.begin.ccls" }
          },
          "patterns": [
            {
              "name": "variable.parameter.ccls",
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=[:),])"
            },
            { "include": "#types" },
            { "include": "$self" }
          ]
        },
        {
          "name": "entity.name.function.call.ccls",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.ccls",
          "match": "\\+=|-=|\\*=|/=|\\+\\+|--"
        },
        {
          "name": "keyword.operator.arrow.ccls",
          "match": "->"
        },
        {
          "name": "keyword.operator.namespace.ccls",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.ccls",
          "match": "==|!=|<=|>=|<<|>>"
        },
        {
          "name": "keyword.operator.logical.ccls",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.power.ccls",
          "match": "\\*\\*"
        },
        {
          "name": "keyword.operator.range.ccls",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.ccls",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.logical.single.ccls",
          "match": "[&|!?~@\\^:]"
        },
        {
          "name": "keyword.operator.assignment.ccls",
          "match": "="
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ccls",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.ccls",
          "match": "\\b(null|unknown)\\b"
        }
      ]
    },
    "meta-directives": {
      "patterns": [
        {
          "name": "meta.directive.ccls",
          "match": "^#!ccls"
        },
        {
          "name": "meta.directive.config.ccls",
          "match": "^#config\\([^)]*\\)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.constant.ccls",
          "match": "\\b([A-Z_][A-Z0-9_]*)\\b"
        },
        {
          "name": "variable.other.declaration.ccls",
          "match": "(?<=\\b(var|let|const)\\s+)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "2": { "name": "variable.other.ccls" }
          }
        }
      ]
    },
    "cmx": {
      "patterns": [
        {
          "name": "meta.cmx.ccls",
          "begin": "(<)([A-Z][a-zA-Z0-9_]*)",
          "end": "(/>)|(</([A-Z][a-zA-Z0-9_]*)>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.ccls" },
            "2": { "name": "entity.name.tag.ccls" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.selfclose.ccls" },
            "2": { "name": "punctuation.definition.tag.end.ccls" },
            "4": { "name": "entity.name.tag.ccls" }
          },
          "patterns": [
            {
              "include": "#cmx-attributes"
            },
            {
              "include": "#cmx-expression"
            },
            {
              "include": "#cmx"
            },
            {
              "name": "text.ccls",
              "match": "[^<{]"
            }
          ]
        }
      ]
    },
    "cmx-attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.ccls",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==)"
        },
        {
          "name": "string.quoted.double.ccls",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ccls",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "cmx-expression": {
      "patterns": [
        {
          "name": "meta.embedded.expression.ccls",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.expression.begin.ccls" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.expression.end.ccls" }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    }
  }
}
