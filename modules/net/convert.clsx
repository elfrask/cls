# net/convert.clsx - Conversión de buffers entre `int[]` y `Char[]`.

# `int[]` (bytes 0..255) -> `Char[]` (unidad de 1 byte).
export function toChars(b: int[]) -> Char[] {
    var out: Char[] = [];
    for each v in (b) {
        out.push(char(v & 255));
    }
    return out;
}

# `Char[]` -> `int[]` (bytes 0..255).
export function toBytes(c: Char[]) -> int[] {
    var out: int[] = [];
    for each ch in (c) {
        out.push(ord(ch) & 255);
    }
    return out;
}
