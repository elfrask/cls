# socket/socket_ffi.clsx - Bindings FFI al shim C `socket_shim` (TCP crudo).
#
# Capa cruda del módulo (no forma parte de la API pública). El shim NO expone
# punteros: handles enteros; los bytes cruzan como `int[]` (CArray).
#
# LIMITACIÓN CONOCIDA DEL FFI: la ruta del shim se resuelve relativa al CWD, no
# al archivo .clsx. Por eso hay que correr desde la raíz del repo (ver README).

when (os: windows) {
    extension "modules/socket/socket_shim.dll" as C {
        export function sk_connect(host: CString, port: CInt) -> CLong;
        export function sk_connect_timeout(host: CString, port: CInt, timeoutMs: CInt) -> CLong;
        export function sk_send(h: CLong, buf: CArray) -> CLong;
        export function sk_shutdown_write(h: CLong) -> CLong;
        export function sk_recv(h: CLong, maxLen: CInt, timeoutMs: CInt) -> CArray;
        export function sk_recv_exact(h: CLong, n: CInt, timeoutMs: CInt) -> CArray;
        export function sk_readable(h: CLong, timeoutMs: CInt) -> CInt;
        export function sk_set_timeout(h: CLong, ms: CInt) -> CLong;
        export function sk_close(h: CLong) -> CLong;
        export function sk_last_error() -> CString;
    };
};
