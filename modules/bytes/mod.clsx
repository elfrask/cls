# bytes - Utilidades de byte: ord/chr (intrínsecos) + hex/diff (CLS puro).
#
# CLS puro, SIN FFI. `Char` es la unidad de 1 byte (modelo bytes/str: un String
# es texto byte-based y `s.toChar()` da su buffer `Char[]`).
#
# Ladrillo de la stdlib autocontenida (examples/patrones.md §11). NO usa
# host_calls. Este archivo es un **barrel**: reexporta la API pública desde los
# archivos enfocados.
#
#   byte.clsx - ord / chr / normalize (sobre los intrínsecos)
#   hex.clsx  - hexEncode / hexDecode
#   diff.clsx - firstDiff

import "byte" as byte;
import "hex" as hex;
import "diff" as diff;

export { byte::ord as ord, byte::chr as chr };
export { hex::hexEncode as hexEncode, hex::hexDecode as hexDecode };
export { diff::firstDiff as firstDiff };
