# bytes/hex.clsx - Codec hexadecimal (minúsculas) para buffers de bytes.
from "byte" import ord, normalize;

# Dígito hex de un nibble (0..15).
function hexNib(b: int) -> String {
    var digits = "0123456789abcdef";
    return digits[b % 16];
}

# Char[] (buffer de bytes) -> string hex en minúsculas (2 chars por byte).
export function hexEncode(bytes: Char[]) -> String {
    var out = "";
    for each b in (bytes) {
        var v = normalize(ord(b));
        out = out + hexNib(v / 16) + hexNib(v % 16);
    }
    return out;
}

# Valor de un dígito hex (0..15); -1 si no es hex.
function hexVal(c: int) -> int {
    if (c >= 48 && c <= 57) { return c - 48; }     # '0'..'9'
    if (c >= 97 && c <= 102) { return c - 87; }    # 'a'..'f'
    if (c >= 65 && c <= 70) { return c - 55; }     # 'A'..'F'
    return -1;
}

# string hex -> int[] (bytes). Ignora un nibble impar final; nibble inválido -> -1.
# Los bytes del hex se obtienen con `hex.toChar()` (Char[]) y su código con `ord`.
export function hexDecode(hex: String) -> int[] {
    var out: int[] = [];
    var cs = hex.toChar();
    var n = cs.length;
    for (var i = 0; i + 1 < n; i = i + 2) {
        var hi = hexVal(ord(cs[i]));
        var lo = hexVal(ord(cs[i + 1]));
        if (hi < 0 || lo < 0) { out.push(-1); }
        else { out.push(hi * 16 + lo); }
    }
    return out;
}
