# prng/lcg.clsx - Generador congruencial lineal (LCG) de 64 bits.
#
# Constantes de PCG; la multiplicación/suma envuelven en i64 (aritmética nativa
# del JIT), así la secuencia es reproducible a partir de la semilla.
const LCG_A = 6364136223846793005;
const LCG_C = 1442695040888963407;

export class Prng {
    var s: int;

    public function main(seed: int) { me.s = seed; }

    # Siguiente estado del LCG (semilla nueva + valor devuelto).
    public function next() -> int {
        me.s = me.s * LCG_A + LCG_C;
        return me.s;
    }

    # Entero en [0, bound); 0 si bound <= 0.
    public function nextInt(bound: int) -> int {
        if (bound <= 0) { return 0; }
        var v = me.next() % bound;
        if (v < 0) { v = v + bound; }
        return v;
    }

    # Flotante en [0, 1) (53 bits del estado / 2^53).
    public function nextFloat() -> float {
        var v = me.next() & 9007199254740991;
        return float(v) / 9007199254740992.0;
    }
};
