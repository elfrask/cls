# orm/sql.clsx - Constructores de fragmentos SQL estándar (sin `strings` del host).

# Une items con un separador.
export function joinList(items: String[], sep: String) -> String {
    var out = "";
    for each item and k in (items) {
        if (k > 0) { out = out + sep; }
        out = out + item;
    }
    return out;
}

# "?, ?, ?" para n placeholders.
export function placeholders(n: int) -> String {
    var out = "";
    for (var k = 0; k < n; k++) {
        if (k > 0) { out = out + ", "; }
        out = out + "?";
    }
    return out;
}

# "a = ?, b = ?" para una lista de columnas.
export function assignList(cols: String[]) -> String {
    var out = "";
    for each col and k in (cols) {
        if (k > 0) { out = out + ", "; }
        out = out + col + " = ?";
    }
    return out;
}

# " ORDER BY ... LIMIT n OFFSET m" (limit < 0 = sin límite).
export function tailClause(orderBy: String, limit: int, offset: int) -> String {
    var out = "";
    if (orderBy != "") { out = out + " ORDER BY " + orderBy; }
    if (limit >= 0) {
        out = out + " LIMIT " + str(limit);
        if (offset > 0) { out = out + " OFFSET " + str(offset); }
    }
    return out;
}
