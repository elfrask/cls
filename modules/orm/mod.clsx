# orm - Capa generica de ORM (agnostica al motor) + contrato de driver.
#
# Ladrillo de la stdlib autocontenida (examples/patrones.md §11): CLS puro, sin
# FFI ni host_calls. Combina el contrato de driver (`Cell`, `ResultSet`,
# `Driver`) y la capa generica (`Orm`) en un solo archivo para evitar
# re-exports.
#
# La capa generica NO conoce el motor: emite SQL estandar + placeholders `?` y
# delega en un `Driver`. Un backend (SQLite en `modules/sqlite`; MySQL/Postgres
# a futuro) hereda de `Driver` y sobrescribe sus metodos.
#
# Valores: los valores viajan como `Cell` (tag + campos tipados) porque el
# typeck del JIT no permite arrays heterogeneos ni tipos dinamicos implicitos. El ORM construye SQL
# estandar + placeholders `?` y enlaza Cells; el driver traduce cada Cell al
# tipo nativo del motor.
#
# Contrato que DEBE cumplir todo driver (ver README):
#   connect(path) -> int          abre una conexion (devuelve handle/0 ok)
#   close() -> int
#   exec(sql) -> int              ejecuta SQL sin resultados (rc 0 = ok)
#   query(sql) -> ResultSet       SELECT (sin parametros)
#   queryBind(sql, params) -> ResultSet   SELECT con placeholders `?`
#   prepare(sql) -> int           sentencia preparada (handle)
#   bind(stmt, idx, cell) -> int  enlaza el parametro idx (1-based)
#   step(stmt) -> int             1 fila / 0 fin / <0 error
#   resetStmt(stmt) -> int        reutiliza el stmt tras un step
#   finalizeStmt(stmt) -> int
#   lastId() -> int               last insert rowid
#   changes() -> int              filas afectadas por el ultimo DML
#   integrity() -> String         chequeo de integridad del motor
#   version() -> String
#
# El SQL que emite el ORM es estandar (no especifico de SQLite).

# --- Tipos de valor neutros al motor ---
export const KIND_NULL = 1;
export const KIND_INT = 2;
export const KIND_FLOAT = 3;
export const KIND_TEXT = 4;
export const KIND_BLOB = 5;

export class Cell {
    public var kind: int;
    public var i: int;
    public var f: float;
    public var s: String;      # TEXT, o hex del BLOB
    public function main(kind: int, i: int, f: float, s: String) {
        me.kind = kind;
        me.i = i;
        me.f = f;
        me.s = s;
    }
    public function isNull() -> bool { return me.kind == KIND_NULL; }
    public function isInt() -> bool { return me.kind == KIND_INT; }
    public function isFloat() -> bool { return me.kind == KIND_FLOAT; }
    public function isText() -> bool { return me.kind == KIND_TEXT; }
    public function isBlob() -> bool { return me.kind == KIND_BLOB; }
};

export function cNull() -> Cell { return Cell(KIND_NULL, 0, 0.0, ""); }
export function cInt(v: int) -> Cell { return Cell(KIND_INT, v, 0.0, ""); }
export function cFloat(v: float) -> Cell { return Cell(KIND_FLOAT, 0, v, ""); }
export function cText(v: String) -> Cell { return Cell(KIND_TEXT, 0, 0.0, v); }
export function cBlob(hex: String) -> Cell { return Cell(KIND_BLOB, 0, 0.0, hex); }

# --- Conjunto de resultados materializado (filas x columnas) ---
export class ResultSet {
    public var nrows: int;
    public var ncols: int;
    public var cols: String[];
    public var cells: Cell[];       # nrows * ncols en orden row-major
    public function main() {
        me.nrows = 0;
        me.ncols = 0;
        me.cols = [];
        me.cells = [];
    }
    public function at(r: int, c: int) -> Cell { return me.cells[r * me.ncols + c]; }
    public function __len() -> int { return me.nrows; }
    public function getInt(r: int, c: int) -> int { return me.at(r, c).i; }
    public function getFloat(r: int, c: int) -> float { return me.at(r, c).f; }
    public function getText(r: int, c: int) -> String { return me.at(r, c).s; }
    public function colIndex(name: String) -> int {
        for each c and k in (me.cols) {
            if (c == name) { return k; }
        }
        return -1;
    }
};

# --- Clase base del driver (backend) ---
export class Driver {
    public function connect(path: String) -> int { return -1; }
    public function close() -> int { return -1; }
    public function exec(sql: String) -> int { return -1; }
    public function query(sql: String) -> ResultSet { return ResultSet(); }
    public function queryBind(sql: String, params: Cell[]) -> ResultSet { return ResultSet(); }
    public function prepare(sql: String) -> int { return -1; }
    public function bind(stmt: int, idx: int, cell: Cell) -> int { return -1; }
    public function step(stmt: int) -> int { return -1; }
    public function resetStmt(stmt: int) -> int { return -1; }
    public function finalizeStmt(stmt: int) -> int { return -1; }
    public function lastId() -> int { return -1; }
    public function changes() -> int { return -1; }
    public function integrity() -> String { return ""; }
    public function version() -> String { return ""; }
};

# --- Capa generica del ORM ---
#
# No contiene SQL especifico de SQLite: emite SQL estandar y delega la
# ejecucion en un `Driver`. Agregar MySQL/Postgres = escribir un driver nuevo
# (subclase de `Driver`) sin tocar este archivo.
#
# Las condiciones WHERE se pasan como SQL estandar + parametros `?` (binding),
# nunca interpolando valores en el texto.

# Une items con un separador (sin `strings` del host: CLS puro).
function joinList(items: String[], sep: String) -> String {
    var out = "";
    for each item and k in (items) {
        if (k > 0) { out = out + sep; }
        out = out + item;
    }
    return out;
}

# "?, ?, ?" para n placeholders.
function placeholders(n: int) -> String {
    var out = "";
    for (var k = 0; k < n; k++) {
        if (k > 0) { out = out + ", "; }
        out = out + "?";
    }
    return out;
}

# "a = ?, b = ?" para una lista de columnas.
function assignList(cols: String[]) -> String {
    var out = "";
    for each col and k in (cols) {
        if (k > 0) { out = out + ", "; }
        out = out + col + " = ?";
    }
    return out;
}

# " ORDER BY ... LIMIT n OFFSET m" (limit < 0 = sin limite).
function tailClause(orderBy: String, limit: int, offset: int) -> String {
    var out = "";
    if (orderBy != "") { out = out + " ORDER BY " + orderBy; }
    if (limit >= 0) {
        out = out + " LIMIT " + str(limit);
        if (offset > 0) { out = out + " OFFSET " + str(offset); }
    }
    return out;
}

export class Orm {
    var d: Driver;
    function main(driver: Driver) { me.d = driver; }

    function exec(sql: String) -> int { return me.d.exec(sql); }
    function query(sql: String) -> ResultSet { return me.d.query(sql); }
    function begin() -> int { return me.d.exec("BEGIN"); }
    function commit() -> int { return me.d.exec("COMMIT"); }
    function rollback() -> int { return me.d.exec("ROLLBACK"); }
    function integrity() -> String { return me.d.integrity(); }
    function engineVersion() -> String { return me.d.version(); }
    function lastId() -> int { return me.d.lastId(); }
    function changes() -> int { return me.d.changes(); }

    function createTable(table: String, colDefs: String[]) -> int {
        return me.d.exec("CREATE TABLE " + table + " (" + joinList(colDefs, ", ") + ")");
    }

    function dropTable(table: String) -> int {
        return me.d.exec("DROP TABLE IF EXISTS " + table);
    }

    # INSERT de una fila; devuelve el last_insert_rowid.
    function insert(table: String, cols: String[], vals: Cell[]) -> int {
        var sql = "INSERT INTO " + table + " (" + joinList(cols, ", ") +
                  ") VALUES (" + placeholders(cols.length) + ")";
        var s = me.d.prepare(sql);
        for each v and k in (vals) { me.d.bind(s, k + 1, v); }
        me.d.step(s);
        var id = me.d.lastId();
        me.d.finalizeStmt(s);
        return id;
    }

    # INSERT de muchas filas en UNA transaccion con el mismo stmt preparado.
    function insertBatch(table: String, cols: String[], rows: Cell[][]) -> int {
        var sql = "INSERT INTO " + table + " (" + joinList(cols, ", ") +
                  ") VALUES (" + placeholders(cols.length) + ")";
        var s = me.d.prepare(sql);
        me.d.exec("BEGIN");
        var n = 0;
        for each row in (rows) {
            for each v and k in (row) { me.d.bind(s, k + 1, v); }
            me.d.step(s);
            me.d.resetStmt(s);
            n = n + 1;
        }
        me.d.exec("COMMIT");
        me.d.finalizeStmt(s);
        return n;
    }

    # --- Bulk streaming (una fila por vez; evita mantener Cell[][] en memoria) ---
    function prepareInsert(table: String, cols: String[]) -> int {
        var sql = "INSERT INTO " + table + " (" + joinList(cols, ", ") +
                  ") VALUES (" + placeholders(cols.length) + ")";
        return me.d.prepare(sql);
    }
    function bulkRow(stmt: int, vals: Cell[]) -> int {
        for each v and k in (vals) { me.d.bind(stmt, k + 1, v); }
        var rc = me.d.step(stmt);
        me.d.resetStmt(stmt);
        return rc;
    }
    function finishInsert(stmt: int) -> int { return me.d.finalizeStmt(stmt); }

    # DML con parametros (UPDATE/DELETE); devuelve filas afectadas.
    function runDml(sql: String, params: Cell[]) -> int {
        var s = me.d.prepare(sql);
        for each p and k in (params) { me.d.bind(s, k + 1, p); }
        me.d.step(s);
        me.d.finalizeStmt(s);
        return me.d.changes();
    }

    function selectAll(table: String, orderBy: String) -> ResultSet {
        return me.d.query("SELECT * FROM " + table + tailClause(orderBy, -1, 0));
    }

    function selectWhere(table: String, whereSql: String, params: Cell[],
                         orderBy: String, limit: int, offset: int) -> ResultSet {
        var sql = "SELECT * FROM " + table + " WHERE " + whereSql +
                  tailClause(orderBy, limit, offset);
        return me.d.queryBind(sql, params);
    }

    function findById(table: String, id: int) -> ResultSet {
        var p: Cell[] = [cInt(id)];
        return me.d.queryBind("SELECT * FROM " + table + " WHERE id = ?", p);
    }

    function update(table: String, setCols: String[], setVals: Cell[],
                    whereSql: String, whereParams: Cell[]) -> int {
        var sql = "UPDATE " + table + " SET " + assignList(setCols) +
                  " WHERE " + whereSql;
        var p: Cell[] = [...setVals, ...whereParams];
        return me.runDml(sql, p);
    }

    function deleteWhere(table: String, whereSql: String, params: Cell[]) -> int {
        return me.runDml("DELETE FROM " + table + " WHERE " + whereSql, params);
    }

    function count(table: String) -> int {
        var rs = me.d.query("SELECT COUNT(*) FROM " + table);
        return rs.getInt(0, 0);
    }

    function countWhere(table: String, whereSql: String, params: Cell[]) -> int {
        var rs = me.d.queryBind("SELECT COUNT(*) FROM " + table + " WHERE " + whereSql, params);
        return rs.getInt(0, 0);
    }
};
