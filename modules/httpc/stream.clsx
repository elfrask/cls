# http/stream.clsx - Lectura del cuerpo HTTP desde el socket (length/chunked/EOF).
#
# Nota de codegen: las llamadas a `socket::line` pasan `maxLen` EXPLÍCITO (no
# omiten el default) — omitir el default de una función de OTRO módulo hoy emite
# WASM inválido.
import "socket" as socket;

function hexToInt(hex: String) -> int {
    var cs = hex.toChar();
    var v = 0;
    for each ch in (cs) {
        var c = ord(ch) & 255;
        var d = -1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        elif (c >= 97 && c <= 102) { d = c - 87; }
        elif (c >= 65 && c <= 70) { d = c - 55; }
        if (d < 0) { break; }
        v = v * 16 + d;
    }
    return v;
}

# Decodifica Transfer-Encoding: chunked (con trailers opcionales).
export function readChunked(h: int, timeoutMs: int) -> String {
    var out = "";
    loop {
        var sizeLine = socket::line(h, timeoutMs, 65536);
        var semi = sizeLine.indexOf(";");
        var hex = sizeLine;
        if (semi >= 0) { hex = sizeLine.slice(0, semi); }
        var n = hexToInt(hex.trim());
        if (n <= 0) {
            loop {
                var t = socket::line(h, timeoutMs, 65536);
                if (t == "") { break; }
            }
            break;
        }
        var chunk: int[] = socket::recvExact(h, n, timeoutMs);
        out = out + socket::fromBytes(chunk);
        var crlf: int[] = socket::recvExact(h, 2, timeoutMs);
    }
    return out;
}

# Lee exactamente n bytes (Content-Length) como texto.
export function readBodyLength(h: int, n: int, timeoutMs: int) -> String {
    var b: int[] = socket::recvExact(h, n, timeoutMs);
    return socket::fromBytes(b);
}

# Lee hasta EOF (Connection: close, sin Content-Length).
export function readToEof(h: int, timeoutMs: int) -> String {
    var out = "";
    loop {
        var b: int[] = socket::recv(h, 65536, timeoutMs);
        if (b.length == 0) { break; }
        out = out + socket::fromBytes(b);
    }
    return out;
}
