# httpd/srv_status.clsx - Razones HTTP y helpers de estado.

# Texto estándar del status (RFC 9110). "Unknown" si no se reconoce.
export function reason(status: int) -> String {
    return match (status) in {
        100 -> "Continue",
        200 -> "OK",
        201 -> "Created",
        202 -> "Accepted",
        204 -> "No Content",
        301 -> "Moved Permanently",
        302 -> "Found",
        303 -> "See Other",
        304 -> "Not Modified",
        307 -> "Temporary Redirect",
        308 -> "Permanent Redirect",
        400 -> "Bad Request",
        401 -> "Unauthorized",
        403 -> "Forbidden",
        404 -> "Not Found",
        405 -> "Method Not Allowed",
        409 -> "Conflict",
        422 -> "Unprocessable Entity",
        429 -> "Too Many Requests",
        500 -> "Internal Server Error",
        502 -> "Bad Gateway",
        503 -> "Service Unavailable",
        default -> "Unknown",
    };
}

export function is_success(status: int) -> bool {
    return status >= 200 && status < 300;
}

export function is_redirect(status: int) -> bool {
    return status >= 300 && status < 400;
}
