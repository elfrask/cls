# sqlite/backend.clsx - Backend SQLite del ORM (implementa el contrato `Driver`).
import "orm" as orm;
from "orm" import Driver;
from "map" import materialize;
from "sqlite_ffi" import sq_init, sq_open, sq_close, sq_exec, sq_last_id, sq_changes,
     sq_integrity, sq_query, sq_result_from_stmt, sq_prepare, sq_bind_null, sq_bind_int,
     sq_bind_double, sq_bind_text, sq_bind_blob_hex, sq_step, sq_reset, sq_finalize,
     sq_column_int, sq_free_result, sq_version, sq_error, sq_remove;

export class SqliteDriver: Driver {
    var h: int;
    function main() {
        me.h = -1;
        sq_init();
    }

    function connect(path: String) -> int {
        me.h = int(sq_open(path));
        return me.h;
    }
    function close() -> int { return int(sq_close(me.h)); }
    function exec(sql: String) -> int { return int(sq_exec(me.h, sql)); }
    function query(sql: String) -> orm::ResultSet {
        return materialize(int(sq_query(me.h, sql)));
    }
    function queryBind(sql: String, params: orm::Cell[]) -> orm::ResultSet {
        var s = int(sq_prepare(me.h, sql));
        for each prm and k in (params) {
            me.bind(s, k + 1, prm);
        }
        var rs = materialize(int(sq_result_from_stmt(s)));
        sq_finalize(s);
        return rs;
    }
    function prepare(sql: String) -> int { return int(sq_prepare(me.h, sql)); }
    function bind(stmt: int, idx: int, cell: orm::Cell) -> int {
        return match (cell.kind) in {
            1 -> int(sq_bind_null(stmt, idx)),
            2 -> int(sq_bind_int(stmt, idx, cell.i)),
            3 -> int(sq_bind_double(stmt, idx, cell.f)),
            4 -> int(sq_bind_text(stmt, idx, cell.s)),
            5 -> int(sq_bind_blob_hex(stmt, idx, cell.s)),
            default -> int(sq_bind_null(stmt, idx)),
        };
    }
    function step(stmt: int) -> int { return int(sq_step(stmt)); }
    function resetStmt(stmt: int) -> int { return int(sq_reset(stmt)); }
    function finalizeStmt(stmt: int) -> int { return int(sq_finalize(stmt)); }
    function lastId() -> int { return int(sq_last_id(me.h)); }
    function changes() -> int { return int(sq_changes(me.h)); }
    function integrity() -> String { return sq_integrity(me.h); }
    function version() -> String { return sq_version(""); }
    function errmsg() -> String { return sq_error(""); }

    # Devuelve una columna entera como `CArray` (int[]) directo del shim:
    # ejercita el marshalling CArray del FFI sin pasar por ResultSet.
    function columnInts(sql: String, col: int) -> int[] {
        var rr = int(sq_query(me.h, sql));
        var arr = sq_column_int(rr, col);
        sq_free_result(rr);
        return arr;
    }
};

# Utilidad de archivo del shim (borrar la db para correr desde cero).
export function removeFile(path: String) -> int { return int(sq_remove(path)); }
