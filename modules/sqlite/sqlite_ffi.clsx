# sqlite/ffi.clsx - Bindings FFI al shim C `sqlite_shim`.
#
# Envuelve la API C de SQLite SIN exponer punteros a CLS: conexiones, sentencias
# y result sets son handles enteros. Capa cruda del módulo (no pública).
#
# La ruta del shim (`.dll`/`.so`/`.dylib`) se resuelve contra la raíz del
# paquete. El shim autolocaliza SQLite (junto a él, en `CLS_SQLITE_PATH` o en la
# carga estándar del sistema).

when (os: windows) {
    extension "./sqlite_shim.dll" as C {
        export function sq_init() -> CLong;
        export function sq_version(_d: CString) -> CString;
        export function sq_error(_d: CString) -> CString;
        export function sq_remove(path: CString) -> CLong;

        export function sq_open(path: CString) -> CLong;
        export function sq_close(h: CLong) -> CLong;
        export function sq_exec(h: CLong, sql: CString) -> CLong;
        export function sq_last_id(h: CLong) -> CLong;
        export function sq_changes(h: CLong) -> CLong;
        export function sq_integrity(h: CLong) -> CString;

        export function sq_query(h: CLong, sql: CString) -> CLong;
        export function sq_result_from_stmt(s: CLong) -> CLong;
        export function sq_nrows(r: CLong) -> CLong;
        export function sq_ncols(r: CLong) -> CLong;
        export function sq_colname(r: CLong, c: CLong) -> CString;
        export function sq_cell_type(r: CLong, i: CLong, c: CLong) -> CLong;
        export function sq_cell_int(r: CLong, i: CLong, c: CLong) -> CLong;
        export function sq_cell_double(r: CLong, i: CLong, c: CLong) -> CDouble;
        export function sq_cell_text(r: CLong, i: CLong, c: CLong) -> CString;
        export function sq_cell_blob_hex(r: CLong, i: CLong, c: CLong) -> CString;
        export function sq_column_int(r: CLong, c: CLong) -> CArray;
        export function sq_free_result(r: CLong) -> CLong;

        export function sq_prepare(h: CLong, sql: CString) -> CLong;
        export function sq_bind_int(s: CLong, idx: CLong, v: CLong) -> CLong;
        export function sq_bind_double(s: CLong, idx: CLong, v: CDouble) -> CLong;
        export function sq_bind_text(s: CLong, idx: CLong, v: CString) -> CLong;
        export function sq_bind_null(s: CLong, idx: CLong) -> CLong;
        export function sq_bind_blob_hex(s: CLong, idx: CLong, hex: CString) -> CLong;
        export function sq_step(s: CLong) -> CLong;
        export function sq_reset(s: CLong) -> CLong;
        export function sq_finalize(s: CLong) -> CLong;
    };
};

