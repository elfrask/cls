import "check" as check;
import "env" as env;

function main(args: String[]) -> int {
    check::reset();
    var text = "# comentario\nA=1\nB=\"hola # mundo\"\nexport C=yes\nD=2 # cola\nE = 'x'\n";
    var e = env::parse(text, ".env");
    check::assertEqStr("env.a", e.get("A"), "1");
    check::assertEqStr("env.quote", e.get("B"), "hola # mundo");
    check::assertTrue("env.export", e.get_bool("C"));
    check::assertEqStr("env.comment", e.get("D"), "2");
    check::assertEqStr("env.single", e.get("E"), "x");
    check::assertEq("env.int", e.get_int("A"), 1);
    check::assertTrue("env.has", e.has("B"));
    check::assertTrue("env.missing", !e.has("Z"));
    if (check::fails() > 0) { return 1; };
    return 0;
};
